#!/usr/bin/env python3
# SPDX-License-Identifier: GPL-2.0-or-later
"""qdevctl: qdev-host devices for Proxmox VE VMs (stock PVE, no patches).

  qdevctl add VMID ID --plugin tb-vga [--args 'vram=16,edid=/path'] [--bus qdev-tbN|qdev-rp0|ich9-pcie-port-N]
                      [--kms /dev/dri/cardN:CONNECTOR] [--no-display] [--persistent] [--port-addr 0x08]
  qdevctl remove VMID ID [--keep-process]
  qdevctl list [VMID]
  qdevctl status VMID
  qdevctl start VMID [ID]      start device process(es) and hot-plug into the running VM
  qdevctl stop VMID [ID]       hot-unplug and stop device process(es)
  qdevctl hook VMID PHASE      called by the guest hookscript (post-start, post-stop, ...)
  qdevctl tb VMID [--ports N]  the VM's TB bus: hot-plug PCIe root ports with Thunderbolt ACPI properties

TB bus devices are QEMU's own: --plugin tb-pci (--args 'host=0000:06:00.0', PVE's hostpciN
syntax), tb-net (--args 'virtio,bridge=vmbr0[,tag=N]', PVE's netN syntax), tb-xhci (a USB
controller) and tb-usb (--args 'host=VENDOR:PRODUCT|BUS-PORT' --bus ID-of-a-tb-xhci).

Device definitions live in /etc/qdev-host/vms/VMID.json. `add` also sets the VM's
hookscript (chaining an existing one) and puts the device on a free port of the
VM's TB bus: hot-plug PCIe root ports with Thunderbolt ACPI properties, added to
the VM's `args` with the first device (needs a VM restart once).
"""
import argparse, json, re, sys
sys.path.insert(0, "/usr/lib/qdev-host/pve")
import qdev_pve as Q
import qdev_tb as TB

def cmd_add(a):
    for m in Q.add_device(a.vmid, a.id, a.plugin, a.args or "", a.bus, not a.no_display, a.kms, a.persistent,
                          a.port_addr, a.extra or []):
        print(m)

def cmd_remove(a):
    for m in Q.remove_device(a.vmid, a.id, a.keep_process, a.purge_port):
        print(m)

def _state_text(d):
    if d["state"] == "attached":
        return f"attached ({d['pci']})" if d.get("pci") else "attached"
    if d["kind"] == "tb":
        return "not attached" + (" (TB bus appears at next VM start)" if d["needs_restart"] else "")
    if d["state"] == "process":
        return "process running, not attached" + (" (root port appears at next VM start)" if d["needs_restart"] else "")
    return "stopped"

def cmd_list(a):
    paths = [Q.conf_path(a.vmid)] if a.vmid else sorted(Q.CONF_DIR.glob("*.json"))
    for p in paths:
        if not p.exists():
            continue
        info = Q.describe_vm(json.loads(p.read_text())["vmid"])
        for d in info["devices"]:
            print(f"VM {info['vmid']}  {d['id']:12s} {d['plugin']:10s} bus={d['bus']:16s} {_state_text(d)}" +
                  (f"  kms={d['kms']}" if d.get("kms") else ""))

def cmd_status(a):
    info = Q.describe_vm(a.vmid)
    if not info["local"]:
        print(f"VM {a.vmid} is on node {info['node']}"); return 1
    print(f"VM {a.vmid}: {'running' if info['running'] else 'stopped'}, {len(info['devices'])} device(s), "
          f"port addr {info['port_addr']} (in args: {info['port_in_args']}, in running VM: {info['port_in_vm']})")
    tb = info["tb"]
    if tb["enabled"]:
        print(f"  TB bus: {tb['ports']} port(s) qdev-tb0..{tb['ports'] - 1}, ACPI {tb['acpi']}, {tb['hotplug']} hot-plug (in args: {tb['in_args']}, "
              f"in running VM: {tb['in_vm']}), {TB.cfg_path(a.vmid)}, {TB.aml_path(a.vmid)}")
    for d in info["devices"]:
        if d["kind"] == "tb":
            print(f"  {d['id']}: plugin={d['plugin']} args='{d['args']}' bus={d['bus']} {_state_text(d)}")
            continue
        u = Q.unit_name(a.vmid, d["id"], d["kind"])
        print(f"  {d['id']}: plugin={d['plugin']} args='{d['args']}' bus={d['bus']} unit={u} "
              f"({'active' if d['process_active'] else 'inactive'}) {_state_text(d)}")
        if d["kind"] == "vhost-user-gpu":
            print(f"      GPU socket {Q.gpu_socket(a.vmid, d['id'])}")
            continue
        print(f"      vfio socket {Q.device_socket(a.vmid, d['id'])}" +
              (f", Display1 p2p {Q.device_display(a.vmid, d['id'])}" if d.get('display', True) else "") +
              (f", KMS {d['kms']}" if d.get("kms") else ""))

def cmd_start(a):
    conf = Q.load_conf(a.vmid)
    for d in conf["devices"]:
        if a.id and d["id"] != a.id:
            continue
        if Q.vm_running(a.vmid):
            print(Q.attach(a.vmid, d))
        elif Q.dev_kind(d) == "tb":
            print(f"{d['id']}: present from the next VM start")
        else:
            Q.start_process(a.vmid, d); print(f"{d['id']}: process started (VM not running)")

def cmd_stop(a):
    conf = Q.load_conf(a.vmid)
    for d in conf["devices"]:
        if a.id and d["id"] != a.id:
            continue
        print(Q.detach(a.vmid, d, keep_process=False))

def cmd_set(a):
    kms = "" if a.no_kms else a.kms
    display = True if a.display else (False if a.no_display else None)
    persistent = True if a.persistent else (False if a.no_persistent else None)
    for m in Q.update_device(a.vmid, a.id, a.args, kms, display, persistent):
        print(m)

def cmd_tb(a):
    conf = Q.load_conf(a.vmid)
    if not Q.is_q35(Q.vm_config(a.vmid)):
        raise Q.QdevError(f"VM {a.vmid} is not a q35 machine")
    for key in ("io_reserve", "mem_reserve", "pref64_reserve"):
        value = getattr(a, key)
        if value is not None:
            if value and not re.match(r"^[0-9]+[KMG]?$", value):
                raise Q.QdevError(f"--{key.replace('_', '-')} takes a size such as 32M (empty: QEMU's default)")
            conf.setdefault("tb", {})[key.replace("_", "-")] = value
    for m in TB.set_ports(a.vmid, conf, a.ports or TB.port_count(conf), a.acpi, a.hotplug, a.power_controller):
        print(m)

def _target(pos, control, want_backing):
    """Resolve a device target. Forms:
        VMID ID [BACKING]            (PVE: resolve control.sock from the config)
        --control PATH   [BACKING]   (raw qdev-host, e.g. a bring-up harness)
    Returns (control_path, vmid, dev_id, backing)."""
    backing = None
    if control:
        if want_backing:
            if len(pos) != 1:
                raise Q.QdevError("with --control, give exactly: BACKING")
            backing = pos[0]
        elif pos:
            raise Q.QdevError("with --control, give no positional arguments")
        return control, 0, "", backing
    need = 3 if want_backing else 2
    if len(pos) != need:
        raise Q.QdevError(f"need VMID ID{' BACKING' if want_backing else ''} (or --control PATH)")
    vmid = int(pos[0]); dev_id = pos[1]
    if want_backing:
        backing = pos[2]
    return str(Q.device_control(vmid, dev_id)), vmid, dev_id, backing

def cmd_device_abi(a):
    # Report the FROZEN envelope/transport ABI version read from the live device.
    # increment 3's updater compares this to a bundle's ABI tag: same envelope =>
    # warm-swap OK (even if the bundle adds commands); change => reboot required.
    cp, _, _, _ = _target(a.pos, a.control, want_backing=False)
    print(Q.device_abi(cp))

def cmd_device_swap(a):
    # Warm-swap the device's VARIABLE backing under a live guest: quiesce ->
    # dlopen-swap the new backing .so/bundle (or tag) -> resume, with the
    # vfio-user process kept alive. --reset hotplug re-enumerates the guest so a
    # live guest re-handshakes and sees the new backing without a guest reboot.
    cp, vmid, dev_id, backing = _target(a.pos, a.control, want_backing=True)
    for m in Q.device_swap(cp, backing, reset=a.reset, vmid=vmid, dev_id=dev_id):
        print(m)

def cmd_device_reload(a):
    # In-process REAL-backend reload under a live, un-rebooted guest on STOCK
    # QEMU (no device_del/add, vfio-user stays BOUND): quiesce -> destroy the
    # live backend Session + dlmopen a new co-resident backend build + re-create
    # the Session re-adopting device state -> device reset re-handshake -> resume.
    # Same ABI gate (frozen envelope) + health gate (0 new QMU errors, gpuRestart
    # within budget, HandshakeGeneration bumps) + auto-rollback as device-swap.
    cp, vmid, dev_id, backing = _target(a.pos, a.control, want_backing=True)
    for m in Q.device_reload(cp, backing, reset=not a.no_reset,
                             expect_gpurestart=a.expect_gpurestart,
                             rollback=not a.no_rollback,
                             allow_guest_gpu_loss=a.allow_guest_gpu_loss,
                             allow_unflushed=a.allow_unflushed):
        print(m)

def cmd_hook(a):
    conf = Q.load_conf(a.vmid)
    rc = 0
    if a.phase == "pre-start":
        try:
            for note in TB.pre_start(a.vmid, conf):
                print(f"qdev-host: {note}", file=sys.stderr)
        except Q.QdevError as e:
            print(f"qdev-host: TB bus: {e}", file=sys.stderr)
            return 2
        # a vhost-user GPU is on QEMU's command line: its process must listen before QEMU starts
        gpus = [d for d in conf["devices"] if Q.dev_kind(d) == "vhost-user-gpu"]
        if gpus:
            cfg = Q.vm_config(a.vmid)
            problem = Q.shared_memory_mismatch(cfg)
            if problem:
                print(f"qdev-host: {problem}. Open the GPU in the VM's Hardware panel and save it "
                      f"(or run: qdevctl set {a.vmid} {gpus[0]['id']}), then start the VM again.", file=sys.stderr)
                return 2
            for d in gpus:
                if f"id={d['id']}," not in cfg.get("args", ""):
                    print(f"qdev-host: {d['id']} is missing from the VM's args (edited by hand?); "
                          f"run: qdevctl set {a.vmid} {d['id']}", file=sys.stderr)
                    continue
                try:
                    Q.start_process(a.vmid, d)
                    print(f"{d['id']}: GPU process ready")
                except Q.QdevError as e:
                    print(f"qdev-host: {d['id']}: {e}", file=sys.stderr)
                    return 2
    elif a.phase == "post-start":
        later = {d["id"] for d in TB.deferred(a.vmid, conf, Q.vm_config(a.vmid))}
        for m in TB.post_start(a.vmid, conf):
            print(m)
        for d in conf["devices"]:
            if Q.dev_kind(d) in ("vhost-user-gpu", "tb") or d["id"] in later:
                continue
            try:
                print(Q.attach(a.vmid, d))
            except Q.QdevError as e:
                print(f"qdev-host: {d['id']}: {e}", file=sys.stderr); rc = 1
    elif a.phase == "post-stop":
        try:
            TB.post_stop(a.vmid, conf)
        except Q.QdevError as e:
            print(f"qdev-host: TB bus: {e}", file=sys.stderr)
        # processes of devices removed while the guest still held them (an unplug the guest did not finish)
        keep = {Q.unit_name(a.vmid, d["id"]) for d in conf["devices"] if d.get("persistent")}
        units = Q.run(["systemctl", "list-units", "--plain", "--no-legend", f"qdev-host-device@{a.vmid}-*"],
                      check=False).stdout.split()
        for unit in [u for u in units if u.startswith(f"qdev-host-device@{a.vmid}-") and u not in keep]:
            Q.run(["systemctl", "stop", unit], check=False)
        for d in conf["devices"]:
            if Q.dev_kind(d) == "tb":
                continue
            if Q.dev_kind(d) == "vhost-user-gpu":
                Q.stop_process(a.vmid, d["id"], "vhost-user-gpu")
            elif not d.get("persistent"):
                Q.stop_process(a.vmid, d["id"])
    return rc

def cmd_tb_boot(a):
    return TB.boot_attach(a.vmid)

def main():
    p = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    sub = p.add_subparsers(dest="cmd", required=True)
    s = sub.add_parser("add"); s.add_argument("vmid", type=int); s.add_argument("id")
    s.add_argument("--plugin", required=True); s.add_argument("--args"); s.add_argument("--bus", default="",
        help="a TB port qdev-tbN (default: a free one), qdev-rp0 (before 0.6.0) or a PVE port")
    s.add_argument("--kms"); s.add_argument("--no-display", action="store_true"); s.add_argument("--persistent", action="store_true")
    s.add_argument("--port-addr"); s.add_argument("--extra", action="append", help="extra qdev-host option (repeatable)")
    s.set_defaults(fn=cmd_add)
    s = sub.add_parser("set", help="change a device's settings (no option: apply them to the VM config again)")
    s.add_argument("vmid", type=int); s.add_argument("id"); s.add_argument("--args")
    g = s.add_mutually_exclusive_group(); g.add_argument("--kms"); g.add_argument("--no-kms", action="store_true")
    g = s.add_mutually_exclusive_group(); g.add_argument("--display", action="store_true"); g.add_argument("--no-display", action="store_true")
    g = s.add_mutually_exclusive_group(); g.add_argument("--persistent", action="store_true"); g.add_argument("--no-persistent", action="store_true")
    s.set_defaults(fn=cmd_set)
    s = sub.add_parser("remove"); s.add_argument("vmid", type=int); s.add_argument("id")
    s.add_argument("--keep-process", action="store_true"); s.add_argument("--purge-port", action="store_true"); s.set_defaults(fn=cmd_remove)
    s = sub.add_parser("list"); s.add_argument("vmid", type=int, nargs="?"); s.set_defaults(fn=cmd_list)
    s = sub.add_parser("status"); s.add_argument("vmid", type=int); s.set_defaults(fn=cmd_status)
    s = sub.add_parser("start"); s.add_argument("vmid", type=int); s.add_argument("id", nargs="?"); s.set_defaults(fn=cmd_start)
    s = sub.add_parser("stop"); s.add_argument("vmid", type=int); s.add_argument("id", nargs="?"); s.set_defaults(fn=cmd_stop)
    s = sub.add_parser("hook"); s.add_argument("vmid", type=int); s.add_argument("phase"); s.set_defaults(fn=cmd_hook)
    s = sub.add_parser("tb", help="add the TB bus to the VM, or change its number of ports")
    s.add_argument("vmid", type=int); s.add_argument("--ports", type=int)
    s.add_argument("--acpi", choices=["auto"] + sorted(TB.ACPI_MODES),
                   help="ACPI properties of the ports (auto: none on macOS ports with slot power, else thunderbolt)")
    s.add_argument("--hotplug", choices=TB.HOTPLUG_MODES,
                   help="PCIe hot-plug: native (needed by macOS), acpi (QEMU's q35 default) or auto (native for macOS guests)")
    s.add_argument("--power-controller", choices=("on", "off", "default"),
                   help="slot power controller of the ports (QEMU default on; macOS: on = hot-plug and "
                        "hot-unplug through the slot power handshake, off = hot-plug only)")
    for key, default in (("io-reserve", "0"), ("mem-reserve", "32M"), ("pref64-reserve", "1G")):
        s.add_argument(f"--{key}", help=f"window the firmware reserves per port (default {default}; '' = QEMU's default)")
    s.set_defaults(fn=cmd_tb)
    s = sub.add_parser("tb-boot", help=argparse.SUPPRESS); s.add_argument("vmid", type=int); s.set_defaults(fn=cmd_tb_boot)
    # warm-swap primitives (increment 1): the product-grade command increment 3
    # (`uniq-vgpu update`) wraps. Target a device by VMID+ID (PVE) or by an
    # explicit --control PATH (raw qdev-host, e.g. a bring-up harness).
    s = sub.add_parser("device-abi", help="report a device's FROZEN envelope/ABI version (warm-vs-reboot gate)")
    s.add_argument("pos", nargs="*", metavar="VMID ID", help="VMID ID (or use --control)")
    s.add_argument("--control", help="qdev-host --control socket path (instead of VMID ID)")
    s.set_defaults(fn=cmd_device_abi)
    s = sub.add_parser("device-swap", help="warm-swap a device's VARIABLE backing in process (quiesce->dlopen-swap->resume)")
    s.add_argument("pos", nargs="*", metavar="VMID ID BACKING",
                   help="VMID ID BACKING (or --control PATH BACKING); BACKING = tag A|B|builtin:X or a backing .so/bundle")
    s.add_argument("--control", help="qdev-host --control socket path (instead of VMID ID)")
    s.add_argument("--reset", choices=["hotplug"], default=None,
                   help="trigger the guest re-handshake: hotplug = QMP device_del+device_add (process stays alive)")
    s.set_defaults(fn=cmd_device_swap)
    s = sub.add_parser("device-reload",
                       help="in-process REAL-backend reload in process (quiesce->destroy+dlmopen+re-create->reset->resume), stock QEMU")
    s.add_argument("pos", nargs="*", metavar="VMID ID BACKING",
                   help="VMID ID BACKING (or --control PATH BACKING); BACKING = path to the new backend .so")
    s.add_argument("--control", help="qdev-host --control socket path (instead of VMID ID)")
    s.add_argument("--no-reset", action="store_true",
                   help="do NOT arm the in-place device-reset re-handshake (stage only)")
    s.add_argument("--expect-gpurestart", type=int, default=0,
                   help="tolerated gpuRestart delta across the reload (health gate; default 0)")
    s.add_argument("--no-rollback", action="store_true",
                   help="do NOT auto-rollback to the previous backend on a health-gate failure")
    s.add_argument("--allow-guest-gpu-loss", action="store_true",
                   help="reload even while a guest is attached (qdev-host refuses otherwise: the re-created "
                        "backend Session does not carry the guest-programmed device state, the guest GPU hangs)")
    s.add_argument("--allow-unflushed", action="store_true",
                   help="with a backend state hand-over that does not flush GPU-written resources yet: "
                        "accept that GPU-private contents written since the guest's last synchronize may be lost")
    s.set_defaults(fn=cmd_device_reload)
    a = p.parse_args()
    try:
        rc = a.fn(a)
    except Q.QdevError as e:
        print(f"qdevctl: {e}", file=sys.stderr); return 1
    return rc or 0

if __name__ == "__main__":
    sys.exit(main())
