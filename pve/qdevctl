#!/usr/bin/env python3
# SPDX-License-Identifier: GPL-2.0-or-later
"""qdevctl: qdev-host devices for Proxmox VE VMs (stock PVE, no patches).

  qdevctl add VMID ID --plugin tb-vga [--args 'vram=16,edid=/path'] [--bus qdev-rp0|ich9-pcie-port-N]
                      [--kms /dev/dri/cardN:CONNECTOR] [--no-display] [--persistent] [--port-addr 0x08]
  qdevctl remove VMID ID [--keep-process]
  qdevctl list [VMID]
  qdevctl status VMID
  qdevctl start VMID [ID]      start device process(es) and hot-plug into the running VM
  qdevctl stop VMID [ID]       hot-unplug and stop device process(es)
  qdevctl hook VMID PHASE      called by the guest hookscript (post-start, post-stop, ...)
  qdevctl tb VMID [--ports N]  the VM's TB bus: hot-plug PCIe root ports with Thunderbolt ACPI properties

TB bus devices are QEMU's own: --plugin tb-pci (--args 'host=0000:06:00.0', PVE's hostpciN
syntax), tb-net (--args 'virtio,bridge=vmbr0[,tag=N]', PVE's netN syntax), tb-xhci (a USB
controller) and tb-usb (--args 'host=VENDOR:PRODUCT|BUS-PORT' --bus ID-of-a-tb-xhci).

Device definitions live in /etc/qdev-host/vms/VMID.json. `add` also sets the VM's
hookscript (chaining an existing one) and, for --bus qdev-rp0 (default), adds a
PCIe root port with reserved windows to the VM's `args` (needs a VM restart once).
"""
import argparse, json, sys
sys.path.insert(0, "/usr/lib/qdev-host/pve")
import qdev_pve as Q
import qdev_tb as TB

def cmd_add(a):
    for m in Q.add_device(a.vmid, a.id, a.plugin, a.args or "", a.bus, not a.no_display, a.kms, a.persistent,
                          a.port_addr, a.extra or []):
        print(m)

def cmd_remove(a):
    for m in Q.remove_device(a.vmid, a.id, a.keep_process, a.purge_port):
        print(m)

def _state_text(d):
    if d["state"] == "attached":
        return f"attached ({d['pci']})" if d.get("pci") else "attached"
    if d["kind"] == "tb":
        return "not attached" + (" (TB bus appears at next VM start)" if d["needs_restart"] else "")
    if d["state"] == "process":
        return "process running, not attached" + (" (root port appears at next VM start)" if d["needs_restart"] else "")
    return "stopped"

def cmd_list(a):
    paths = [Q.conf_path(a.vmid)] if a.vmid else sorted(Q.CONF_DIR.glob("*.json"))
    for p in paths:
        if not p.exists():
            continue
        info = Q.describe_vm(json.loads(p.read_text())["vmid"])
        for d in info["devices"]:
            print(f"VM {info['vmid']}  {d['id']:12s} {d['plugin']:10s} bus={d['bus']:16s} {_state_text(d)}" +
                  (f"  kms={d['kms']}" if d.get("kms") else ""))

def cmd_status(a):
    info = Q.describe_vm(a.vmid)
    if not info["local"]:
        print(f"VM {a.vmid} is on node {info['node']}"); return 1
    print(f"VM {a.vmid}: {'running' if info['running'] else 'stopped'}, {len(info['devices'])} device(s), "
          f"port addr {info['port_addr']} (in args: {info['port_in_args']}, in running VM: {info['port_in_vm']})")
    tb = info["tb"]
    if tb["enabled"]:
        print(f"  TB bus: {tb['ports']} port(s) qdev-tb0..{tb['ports'] - 1} (in args: {tb['in_args']}, "
              f"in running VM: {tb['in_vm']}), {TB.cfg_path(a.vmid)}, {TB.aml_path(a.vmid)}")
    for d in info["devices"]:
        if d["kind"] == "tb":
            print(f"  {d['id']}: plugin={d['plugin']} args='{d['args']}' bus={d['bus']} {_state_text(d)}")
            continue
        u = Q.unit_name(a.vmid, d["id"])
        print(f"  {d['id']}: plugin={d['plugin']} args='{d['args']}' bus={d['bus']} unit={u} "
              f"({'active' if d['process_active'] else 'inactive'}) {_state_text(d)}")
        print(f"      vfio socket {Q.device_socket(a.vmid, d['id'])}" +
              (f", Display1 p2p {Q.device_display(a.vmid, d['id'])}" if d.get('display', True) else "") +
              (f", KMS {d['kms']}" if d.get("kms") else ""))

def cmd_start(a):
    conf = Q.load_conf(a.vmid)
    for d in conf["devices"]:
        if a.id and d["id"] != a.id:
            continue
        if Q.vm_running(a.vmid):
            print(Q.attach(a.vmid, d))
        elif Q.dev_kind(d) == "tb":
            print(f"{d['id']}: present from the next VM start")
        else:
            Q.start_process(a.vmid, d); print(f"{d['id']}: process started (VM not running)")

def cmd_stop(a):
    conf = Q.load_conf(a.vmid)
    for d in conf["devices"]:
        if a.id and d["id"] != a.id:
            continue
        print(Q.detach(a.vmid, d, keep_process=False))

def cmd_set(a):
    kms = "" if a.no_kms else a.kms
    display = True if a.display else (False if a.no_display else None)
    persistent = True if a.persistent else (False if a.no_persistent else None)
    for m in Q.update_device(a.vmid, a.id, a.args, kms, display, persistent):
        print(m)

def cmd_tb(a):
    conf = Q.load_conf(a.vmid)
    if not Q.is_q35(Q.vm_config(a.vmid)):
        raise Q.QdevError(f"VM {a.vmid} is not a q35 machine")
    for m in TB.set_ports(a.vmid, conf, a.ports or TB.port_count(conf)):
        print(m)

def cmd_hook(a):
    conf = Q.load_conf(a.vmid)
    rc = 0
    if a.phase == "pre-start":
        try:
            for note in TB.pre_start(a.vmid, conf):
                print(f"qdev-host: {note}", file=sys.stderr)
        except Q.QdevError as e:
            print(f"qdev-host: TB bus: {e}", file=sys.stderr)
            return 2
        # a vhost-user GPU is on QEMU's command line: its process must listen before QEMU starts
        gpus = [d for d in conf["devices"] if Q.dev_kind(d) == "vhost-user-gpu"]
        if gpus:
            cfg = Q.vm_config(a.vmid)
            problem = Q.shared_memory_mismatch(cfg)
            if problem:
                print(f"qdev-host: {problem}. Open the GPU in the VM's Hardware panel and save it "
                      f"(or run: qdevctl set {a.vmid} {gpus[0]['id']}), then start the VM again.", file=sys.stderr)
                return 2
            for d in gpus:
                if f"id={d['id']}," not in cfg.get("args", ""):
                    print(f"qdev-host: {d['id']} is missing from the VM's args (edited by hand?); "
                          f"run: qdevctl set {a.vmid} {d['id']}", file=sys.stderr)
                    continue
                try:
                    Q.start_process(a.vmid, d)
                    print(f"{d['id']}: GPU process ready")
                except Q.QdevError as e:
                    print(f"qdev-host: {d['id']}: {e}", file=sys.stderr)
                    return 2
    elif a.phase == "post-start":
        try:
            TB.post_start(a.vmid, conf)
        except Q.QdevError as e:
            print(f"qdev-host: TB bus: {e}", file=sys.stderr); rc = 1
        for d in conf["devices"]:
            if Q.dev_kind(d) in ("vhost-user-gpu", "tb"):
                continue
            try:
                print(Q.attach(a.vmid, d))
            except Q.QdevError as e:
                print(f"qdev-host: {d['id']}: {e}", file=sys.stderr); rc = 1
    elif a.phase == "post-stop":
        try:
            TB.post_stop(a.vmid, conf)
        except Q.QdevError as e:
            print(f"qdev-host: TB bus: {e}", file=sys.stderr)
        for d in conf["devices"]:
            if Q.dev_kind(d) == "tb":
                continue
            if Q.dev_kind(d) == "vhost-user-gpu":
                Q.stop_process(a.vmid, d["id"], "vhost-user-gpu")
            elif not d.get("persistent"):
                Q.stop_process(a.vmid, d["id"])
    return rc

def main():
    p = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    sub = p.add_subparsers(dest="cmd", required=True)
    s = sub.add_parser("add"); s.add_argument("vmid", type=int); s.add_argument("id")
    s.add_argument("--plugin", required=True); s.add_argument("--args"); s.add_argument("--bus", default=Q.PORT_ID)
    s.add_argument("--kms"); s.add_argument("--no-display", action="store_true"); s.add_argument("--persistent", action="store_true")
    s.add_argument("--port-addr"); s.add_argument("--extra", action="append", help="extra qdev-host option (repeatable)")
    s.set_defaults(fn=cmd_add)
    s = sub.add_parser("set", help="change a device's settings (no option: apply them to the VM config again)")
    s.add_argument("vmid", type=int); s.add_argument("id"); s.add_argument("--args")
    g = s.add_mutually_exclusive_group(); g.add_argument("--kms"); g.add_argument("--no-kms", action="store_true")
    g = s.add_mutually_exclusive_group(); g.add_argument("--display", action="store_true"); g.add_argument("--no-display", action="store_true")
    g = s.add_mutually_exclusive_group(); g.add_argument("--persistent", action="store_true"); g.add_argument("--no-persistent", action="store_true")
    s.set_defaults(fn=cmd_set)
    s = sub.add_parser("remove"); s.add_argument("vmid", type=int); s.add_argument("id")
    s.add_argument("--keep-process", action="store_true"); s.add_argument("--purge-port", action="store_true"); s.set_defaults(fn=cmd_remove)
    s = sub.add_parser("list"); s.add_argument("vmid", type=int, nargs="?"); s.set_defaults(fn=cmd_list)
    s = sub.add_parser("status"); s.add_argument("vmid", type=int); s.set_defaults(fn=cmd_status)
    s = sub.add_parser("start"); s.add_argument("vmid", type=int); s.add_argument("id", nargs="?"); s.set_defaults(fn=cmd_start)
    s = sub.add_parser("stop"); s.add_argument("vmid", type=int); s.add_argument("id", nargs="?"); s.set_defaults(fn=cmd_stop)
    s = sub.add_parser("hook"); s.add_argument("vmid", type=int); s.add_argument("phase"); s.set_defaults(fn=cmd_hook)
    s = sub.add_parser("tb", help="add the TB bus to the VM, or change its number of ports")
    s.add_argument("vmid", type=int); s.add_argument("--ports", type=int); s.set_defaults(fn=cmd_tb)
    a = p.parse_args()
    try:
        rc = a.fn(a)
    except Q.QdevError as e:
        print(f"qdevctl: {e}", file=sys.stderr); return 1
    return rc or 0

if __name__ == "__main__":
    sys.exit(main())
