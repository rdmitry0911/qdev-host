# SPDX-License-Identifier: GPL-2.0-or-later
# QEMU's netdev downscript for a network device on qdev-host's TB bus.
use strict;
use warnings;
use PVE::Network;

my $iface = shift;
die "no interface specified\n" if !$iface;
die "got strange interface name '$iface'\n" if $iface !~ m/^tap(\d+)i(\d+)$/;

PVE::Network::tap_unplug($iface);

exit 0;
