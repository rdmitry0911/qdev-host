#!/bin/sh
set -e
case "$1" in
    configure)
        install -d -m 0750 /etc/qdev-host /etc/qdev-host/vms
        install -d -m 0755 /var/lib/qdev-host
        if command -v systemctl >/dev/null 2>&1 && [ -d /run/systemd/system ]; then
            systemctl daemon-reload || true
            systemctl enable --now qdev-host-api.service || true
            systemctl try-restart qdev-host-api.service || true
        fi
        # the overlay descriptor is picked up by pve-ui-overlays' dpkg trigger; this only makes it immediate
        if command -v pve-ui-overlays >/dev/null 2>&1; then pve-ui-overlays reconcile || true; fi
        echo "qdev-host-pve: qdev-host devices can now be added in the VM Hardware panel (Add > qdev-host Device) or with qdevctl"
        ;;
esac
#DEBHELPER#
exit 0
