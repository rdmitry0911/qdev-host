#!/bin/bash
# SPDX-License-Identifier: GPL-2.0-or-later
#
# uniq-vgpu-guest-install - install/update the FIXED resident Uni-Q vGPU kext
# into the macOS guest's Auxiliary Kernel Collection, under sudo. ONE command,
# snapshot-aware and reversible. This is the guest-side half of `uniq-vgpu
# apply`: the host warm-swaps the variable backend with no reboot; a *kext*
# change (a new resident driver, or a first install) is the one path that needs
# this and a guest reboot.
#
#   sudo uniq-vgpu-guest-install <KEXT>            install/update + reboot
#   sudo uniq-vgpu-guest-install <KEXT> --no-reboot --yes   install, don't reboot
#   sudo uniq-vgpu-guest-install <KEXT> --dry-run          STOP-IF checks only, no change
#   sudo uniq-vgpu-guest-install --rollback               restore the prior kext + rebuild AuxKC
#   sudo uniq-vgpu-guest-install <BUNDLE-DIR> --no-gl     kext only: skip the bundle's GL step
#   sudo uniq-vgpu-guest-install <BUNDLE-DIR> --no-wallpaper   keep the guest's desktop picture
#
# <KEXT> is a .kext directory, a .tar of one, OR a `uniq-vgpu` bundle directory
# (the manifest's kext block supplies id / expected sha / uuid / validated builds).
#
# Guest GL bundle: when the bundle manifest has a "gl" block (uniq-vgpu-mkbundle
# --gl-bundle), gl/UniqVGPUGL.bundle.tar + gl/install-gpu-bundle.sh are STOP-IF
# checked with the kext (SHA256SUMS, Contents/MacOS/UniqVGPUGL sha256) before any
# change, and installed AFTER the kext/AuxKC steps, before the reboot, with
# `install-gpu-bundle.sh install UniqVGPUGL <bundle> <sha>` (H-SANDBOX-GPUBUNDLES
# option A: the real bundle in /Library/Apple/System/Library/PrivateFrameworks,
# an absolute link /Library/GPUBundles/UniqVGPUGL.bundle -> it; a leftover former
# AppleVirglGL is retired). The kext publishes IOGLBundleName only when that path
# is a directory at accelerator start, hence the same reboot. --rollback also puts
# the prior GL layout back. A manifest without "gl" installs the kext only.
#
# Static desktop picture (DEFAULT when the manifest has a "wallpaper" block,
# uniq-vgpu-mkbundle --wallpaper-tool; user decision 2026-11-21): the default
# animated aerial wallpaper decodes HEVC video in software in the guest (no video
# decoder), costing host CPU on every frame. After the GL step the installer runs
# the bundle's wallpaper/uniqvgpu-wallpaper.sh (apple-virgl tools/guest, checked
# against SHA256SUMS before any change) `apply <picture>`: a stock static picture
# for every logged-in user now (NSWorkspace in the user's session; the login
# window shows the user's exported picture) and, through its login agent, for every
# other or later user at the next login (once per user). A wallpaper failure is a
# WARN (kext/GL stay installed). --rollback runs the tool's `revert` (each user's
# prior wallpaper store back). --no-wallpaper skips the step.
#
# It performs EXACTLY the sequence validated end-to-end on a 25G342 clone
# (evidence/runs/pvg-warmswap-25g342-*): verify binary sha+uuid -> back up any
# existing kext (recorded for rollback) -> ditto + chown root:wheel ->
# kmutil libraries --undef-symbols -> kmutil clear-staging ->
# kmutil create -n aux (--allow-missing-kdk only when no KDK for the build) ->
# kmutil inspect verify -> reboot. Never rewrites the Boot/System collections,
# so a bad aux kext cannot brick the boot chain (worst case: boot without the
# vGPU, then --rollback).
set -u

# Test seam ONLY: UNIQVGPU_GUEST_TEST_ROOT prefixes every absolute macOS tool and
# filesystem path so tests/uniq-vgpu/test_guest_gl_bundle.py can run this script
# off-guest against doubles. Unset in the guest (sudo also resets the environment):
# ROOT is empty and every path is the real one.
ROOT="${UNIQVGPU_GUEST_TEST_ROOT:-}"
[ -n "$ROOT" ] && echo "guest-install: TEST ROOT $ROOT (doubles, not a guest)"

KEXT_ID_DEFAULT="dev.uniqvgpu.driver"
BOOT="$ROOT"/System/Library/KernelCollections/BootKernelExtensions.kc
SYS="$ROOT"/System/Library/KernelCollections/SystemKernelExtensions.kc
AUX="$ROOT"/Library/KernelCollections/AuxiliaryKernelExtensions.kc
BACKUP_DIR="$ROOT"/var/db/uniqvgpu-kext-backups
ROLLBACK_STATE="$BACKUP_DIR/rollback-state.sh"
DEST_DIR="$ROOT"/Library/Extensions
# guest GL bundle layout = apple-virgl tools/guest/install-gpu-bundle.sh (option A)
GL_NAME=UniqVGPUGL
GL_REAL_DIR="$ROOT"/Library/Apple/System/Library/PrivateFrameworks
GL_LINK_DIR="$ROOT"/Library/GPUBundles
GL_REAL="$GL_REAL_DIR/$GL_NAME.bundle"
GL_LINK="$GL_LINK_DIR/$GL_NAME.bundle"
GL_OLD_NAMES="AppleVirglGL"   # former name; retired by the installer if still present
# static desktop picture tool, installed copy (apple-virgl tools/guest/uniqvgpu-wallpaper.sh apply copies itself here)
WP_SUPPORT="$ROOT/Library/Application Support/UniqVGPU/wallpaper/uniqvgpu-wallpaper.sh"

say()  { echo "guest-install: $*"; }
stop() { echo "guest-install: STOP-IF: $*" >&2; exit 2; }
ok()   { echo "guest-install:   OK  $*"; }

# put a GL path back in the form recorded before install: none | link TARGET | dir BACKUP
gl_restore() { # PATH KIND TARGET BACKUP
  if [ -L "$1" ]; then rm -f "$1"; else rm -rf "$1"; fi
  case "$2" in
    none) ok "GL: removed $1 (absent before install)" ;;
    link) ln -s "$3" "$1" || stop "could not restore link $1 -> $3"
          ok "GL: restored link $1 -> $3" ;;
    dir)  [ -d "$4" ] || stop "GL backup $4 missing; cannot restore $1"
          "$ROOT"/usr/bin/ditto "$4" "$1" && "$ROOT"/usr/sbin/chown -R 0:0 "$1" \
            || stop "could not restore $1 from $4"
          ok "GL: restored $1 from $4" ;;
    *)    stop "rollback state has no prior form for $1" ;;
  esac
}
# record a GL path's prior form in the rollback state (a directory is copied to the backup dir)
gl_snapshot() { # TAG PATH
  if [ -L "$2" ]; then
    printf 'GL_PRIOR_%s_KIND=link\nGL_PRIOR_%s_TARGET="%s"\n' "$1" "$1" "$(readlink "$2")" >> "$ROLLBACK_STATE"
  elif [ -d "$2" ]; then
    _bk="$BACKUP_DIR/$(basename "$2").$1.$TS"
    "$ROOT"/usr/bin/ditto "$2" "$_bk" || stop "could not back up existing $2 (restore the kext with --rollback)"
    printf 'GL_PRIOR_%s_KIND=dir\nGL_PRIOR_%s_BACKUP="%s"\n' "$1" "$1" "$_bk" >> "$ROLLBACK_STATE"
    ok "backed up existing $2 -> $_bk"
  else
    printf 'GL_PRIOR_%s_KIND=none\n' "$1" >> "$ROLLBACK_STATE"
  fi
}

# ------------------------------------------------------------------ args
SRC=""
DO_ROLLBACK=0; DRY_RUN=0; NO_REBOOT=0; ASSUME_YES=0; FORCE_BUILD=0; NO_GL=0; NO_WP=0
EXPECT_SHA=""; EXPECT_UUID=""; KEXT_ID="$KEXT_ID_DEFAULT"; VALIDATED_BUILDS=""
while [ $# -gt 0 ]; do
  case "$1" in
    --rollback)    DO_ROLLBACK=1 ;;
    --dry-run|--check) DRY_RUN=1 ;;
    --no-reboot)   NO_REBOOT=1 ;;
    --yes|-y)      ASSUME_YES=1 ;;
    --force-build) FORCE_BUILD=1 ;;
    --expect-sha)  EXPECT_SHA="$2"; shift ;;
    --expect-uuid) EXPECT_UUID="$2"; shift ;;
    --id)          KEXT_ID="$2"; shift ;;
    --no-gl)       NO_GL=1 ;;
    --no-wallpaper) NO_WP=1 ;;
    -h|--help)     sed -n '3,52p' "$0"; exit 0 ;;
    -*)            stop "unknown option: $1" ;;
    *)             SRC="$1" ;;
  esac
  shift
done

DEST="$DEST_DIR/UniqVGPU.kext"   # refined once we know the bundle basename

# ------------------------------------------------------------------ root
[ "$(id -u)" = "0" ] || stop "must run under sudo (need root for /Library + kmutil)"

# ====================================================================== ROLLBACK
if [ "$DO_ROLLBACK" = "1" ]; then
  [ -f "$ROLLBACK_STATE" ] || stop "no rollback state at $ROLLBACK_STATE (nothing to undo)"
  # shellcheck disable=SC1090
  . "$ROLLBACK_STATE"
  say "rolling back: $PRIOR_SUMMARY"
  DEST="${INSTALLED_DEST:-$DEST}"
  # 1) restore /Library/Extensions to its prior state
  if [ "${PRIOR_EXISTED:-0}" = "1" ] && [ -e "${PRIOR_BACKUP:-/nonexistent}" ]; then
    rm -rf "$DEST"
    "$ROOT"/usr/bin/ditto "$PRIOR_BACKUP" "$DEST" && "$ROOT"/usr/sbin/chown -R 0:0 "$DEST"
    ok "restored prior kext from $PRIOR_BACKUP"
  else
    rm -rf "$DEST"
    ok "removed installed kext (there was no prior kext to restore)"
  fi
  # 1b) the guest GL bundle, only if this install managed it (state from older installs has no GL_MANAGED)
  if [ "${GL_MANAGED:-0}" = "1" ]; then
    gl_restore "$GL_REAL" "${GL_PRIOR_REAL_KIND:-}" "${GL_PRIOR_REAL_TARGET:-}" "${GL_PRIOR_REAL_BACKUP:-}"
    gl_restore "$GL_LINK" "${GL_PRIOR_LINK_KIND:-}" "${GL_PRIOR_LINK_TARGET:-}" "${GL_PRIOR_LINK_BACKUP:-}"
    [ -n "${GL_RETIRED:-}" ] && say "  GL: former $GL_RETIRED stays retired in /var/db/uniqvgpu-retired (the kext publishes only $GL_NAME)"
  fi
  # 1c) the static desktop picture, only if this install applied it: the installed tool restores every user's prior store
  if [ "${WALLPAPER_MANAGED:-0}" = "1" ]; then
    if [ -f "$WP_SUPPORT" ]; then
      WOUT="$("$ROOT"/bin/bash "$WP_SUPPORT" revert 2>&1)"; WRC=$?
      printf '%s\n' "$WOUT" | sed 's/^/    wp| /'
      if [ "$WRC" -eq 0 ] && printf '%s\n' "$WOUT" | grep -q '^WALLPAPER_REVERT_OK'; then ok "wallpaper: prior desktop pictures restored"
      else say "  WARN wallpaper revert rc=$WRC (see wp| lines); kext rollback continues"; fi
    else say "  wallpaper: tool already removed ($WP_SUPPORT absent): nothing to revert"; fi
  fi
  # 2) restore the AuxKC. Preferred: put back the exact pre-install collection file
  # (byte-for-byte PRE==POST). This also correctly handles "no aux kexts remain",
  # where `kmutil create -n aux` with nothing to add errors and would leave the
  # stale collection in place.
  if [ -n "${PRIOR_AUXKC:-}" ] && [ -e "${PRIOR_AUXKC:-/nonexistent}" ]; then
    "$ROOT"/bin/cp -p "$PRIOR_AUXKC" "$AUX" && "$ROOT"/usr/sbin/chown 0:0 "$AUX"
    ok "restored pre-install AuxKC ($("$ROOT"/usr/bin/shasum -a 256 "$AUX" | awk '{print $1}'))"
  elif [ "${PRIOR_AUXKC_EXISTED:-1}" = "0" ]; then
    rm -f "$AUX"
    ok "removed AuxKC (there was none before install)"
  else
    "$ROOT"/usr/bin/kmutil clear-staging >/dev/null 2>&1
    PKR=()
    for k in "$DEST_DIR"/*.kext; do [ -d "$k" ] && PKR+=(-p "$k"); done
    if [ "${#PKR[@]}" -gt 0 ]; then
      "$ROOT"/usr/bin/kmutil create -n aux -L -x "${PKR[@]}" -B "$BOOT" -S "$SYS" -A "$AUX" ${PRIOR_KDK_FLAG:-} \
        || stop "kmutil create (rollback) failed"
      ok "rebuilt AuxKC from $(( ${#PKR[@]} / 2 )) remaining kext(s) in $DEST_DIR"
    else
      rm -f "$AUX"
      ok "no kexts remain in $DEST_DIR; removed the AuxKC"
    fi
  fi
  rm -f "$ROLLBACK_STATE"
  say "rollback complete. Reboot the guest to load the restored collection."
  [ "$NO_REBOOT" = "1" ] && exit 0
  [ "$ASSUME_YES" = "1" ] && { say "rebooting..."; "$ROOT"/sbin/reboot; }
  say "run: sudo reboot"
  exit 0
fi

# ====================================================================== INSTALL
[ -n "$SRC" ] || stop "need a <KEXT> (a .kext, a .tar, or a uniq-vgpu bundle dir)"
[ -e "$SRC" ] || stop "kext source not found: $SRC"

WORK="$("$ROOT"/usr/bin/mktemp -d "$ROOT"/tmp/uniqvgpu-install.XXXXXX)"
cleanup() { rm -rf "$WORK"; }
trap cleanup EXIT

# -- resolve the .kext bundle + expected metadata (bundle manifest / .tar / dir)
KEXTDIR=""
GL_PRESENT=0; GL_DO=0; WP_PRESENT=0; WP_DO=0
if [ -d "$SRC" ] && [ -f "$SRC/uniq-vgpu-bundle.json" ]; then
  say "reading uniq-vgpu bundle manifest"
  MF="$SRC/uniq-vgpu-bundle.json"
  read_json() { # key [block=kext] -> value from that flat block (python3 if present, else grep: kext only)
    if command -v python3 >/dev/null 2>&1; then
      python3 - "$MF" "$1" "${2:-kext}" <<'PY' 2>/dev/null
import json,sys
m=json.load(open(sys.argv[1])); k=m.get(sys.argv[3],{}) or {}
v=k.get(sys.argv[2])
print(" ".join(v) if isinstance(v,list) else (v if v is not None else ""))
PY
    elif [ "${2:-kext}" = "kext" ]; then
      grep -o "\"$1\"[^,}]*" "$MF" | head -1 | sed 's/.*: *//; s/^"//; s/"$//'
    fi
  }
  KREL="$(read_json bundle)";   [ -n "$KREL" ] && KEXTDIR="$SRC/$KREL"
  [ -z "$EXPECT_SHA" ]  && EXPECT_SHA="$(read_json binary_sha256)"
  [ -z "$EXPECT_UUID" ] && EXPECT_UUID="$(read_json uuid)"
  VALIDATED_BUILDS="$(read_json validated_builds)"
  _id="$(read_json id)"; [ -n "$_id" ] && KEXT_ID="$_id"
  # the guest GL bundle block (detected without python3, so an unreadable block fails closed below)
  if grep -q '"gl"[[:space:]]*:' "$MF"; then
    GL_PRESENT=1
    GL_MNAME="$(read_json name gl)";      GL_SHA="$(read_json binary_sha256 gl)"
    GL_TAR_REL="$(read_json bundle gl)";  GL_INST_REL="$(read_json installer gl)"
  fi
  # the static desktop picture block (same fail-closed detection)
  if grep -q '"wallpaper"[[:space:]]*:' "$MF"; then
    WP_PRESENT=1
    WP_TOOL_REL="$(read_json tool wallpaper)"; WP_SETTER_REL="$(read_json setter wallpaper)"
    WP_PIC="$(read_json picture wallpaper)"
  fi
else
  KEXTDIR="$SRC"
fi

# a .tar (or .kext.tar) -> extract
case "$KEXTDIR" in
  *.tar) say "unpacking $(basename "$KEXTDIR")"
         "$ROOT"/usr/bin/tar xf "$KEXTDIR" -C "$WORK" || stop "tar extract failed"
         KEXTDIR="$("$ROOT"/usr/bin/find "$WORK" -maxdepth 2 -name '*.kext' -type d | head -1)"
         [ -n "$KEXTDIR" ] || stop "no .kext found inside the tar" ;;
esac
[ -d "$KEXTDIR" ] || stop "kext bundle is not a directory: $KEXTDIR"
DEST="$DEST_DIR/$(basename "$KEXTDIR")"
BIN="$KEXTDIR/Contents/MacOS/$("$ROOT"/usr/libexec/PlistBuddy -c 'Print :CFBundleExecutable' "$KEXTDIR/Contents/Info.plist" 2>/dev/null)"
[ -f "$BIN" ] || stop "kext has no Mach-O at $BIN"

say "target kext: $KEXTDIR -> $DEST"

# -- STOP-IF 1: identifier
GOT_ID="$("$ROOT"/usr/libexec/PlistBuddy -c 'Print :CFBundleIdentifier' "$KEXTDIR/Contents/Info.plist" 2>/dev/null)"
[ "$GOT_ID" = "$KEXT_ID" ] || stop "CFBundleIdentifier '$GOT_ID' != expected '$KEXT_ID'"
ok "identifier $GOT_ID"

# -- STOP-IF 2: binary sha (if expected)
GOT_SHA="$("$ROOT"/usr/bin/shasum -a 256 "$BIN" | awk '{print $1}')"
if [ -n "$EXPECT_SHA" ]; then
  [ "$GOT_SHA" = "$EXPECT_SHA" ] || stop "binary sha256 $GOT_SHA != expected $EXPECT_SHA"
  ok "binary sha256 $GOT_SHA"
else
  say "  (no expected sha given; binary sha256 $GOT_SHA)"
fi

# -- STOP-IF 3: binary UUID (if expected)
GOT_UUID="$("$ROOT"/usr/bin/dwarfdump --uuid "$BIN" 2>/dev/null | awk '{print $2}' | head -1)"
if [ -n "$EXPECT_UUID" ]; then
  [ "$GOT_UUID" = "$EXPECT_UUID" ] || stop "LC_UUID $GOT_UUID != expected $EXPECT_UUID"
  ok "binary uuid $GOT_UUID"
else
  say "  (binary uuid $GOT_UUID)"
fi

# -- STOP-IF 4: macOS build in the validated set; decide the KDK flag
BUILD="$("$ROOT"/usr/bin/sw_vers -buildVersion)"
PRODVER="$("$ROOT"/usr/bin/sw_vers -productVersion)"
say "macOS $PRODVER build $BUILD"
if [ -n "$VALIDATED_BUILDS" ] && [ "$FORCE_BUILD" != "1" ]; then
  echo " $VALIDATED_BUILDS " | grep -q " $BUILD " \
    || stop "build $BUILD not in validated set ($VALIDATED_BUILDS); re-validate kmutil create for it or pass --force-build"
  ok "build $BUILD in validated set"
fi
# KDK present for this build? -> build with it; else aux-only --allow-missing-kdk
KDK_FLAG=""
if ls "$ROOT/Library/Developer/KDKs/" 2>/dev/null | grep -q "_${BUILD}\.kdk$"; then
  ok "KDK present for $BUILD (building with it)"
else
  KDK_FLAG="--allow-missing-kdk"
  ok "no KDK for $BUILD -> aux-only build (--allow-missing-kdk)"
fi

# -- STOP-IF 5: SIP posture (unsigned kext needs KEXT SIGNING disabled to LOAD).
# Look specifically at the Kext Signing line (NOT a blanket "enabled" grep -- other
# protections like "NVRAM Protections: enabled" are irrelevant to loading a kext).
SIP="$("$ROOT"/usr/bin/csrutil status 2>/dev/null)"
say "SIP: $(printf '%s' "$SIP" | tr '\n' ' ')"
SIP_BLOCK=0
if printf '%s' "$SIP" | grep -qi "Kext Signing: enabled"; then
  SIP_BLOCK=1
elif printf '%s' "$SIP" | grep -qiE "Integrity Protection status: enabled\.?" \
     && ! printf '%s' "$SIP" | grep -qi "Kext Signing"; then
  SIP_BLOCK=1   # fully enabled, no per-feature breakdown -> kext signing is on
fi
if [ "$SIP_BLOCK" = "1" ]; then
  if [ "$ASSUME_YES" != "1" ]; then
    stop "Kext Signing is ENABLED; an unsigned kext will build but NOT load at boot. Disable it (recovery: csrutil enable --without kext, or set csr-active-config) then re-run, or pass --yes to proceed anyway."
  fi
  say "  WARNING: Kext Signing enabled; proceeding on --yes (the aux kext may not load at boot)"
else
  ok "SIP posture permits an unsigned aux kext to load (Kext Signing not enforced)"
fi

# -- STOP-IF 6: the guest GL bundle (manifest "gl" block), checked before ANY change
if [ "$GL_PRESENT" = "1" ] && [ "$NO_GL" = "1" ]; then
  say "GL: the bundle ships $GL_NAME but --no-gl was given -> GL step SKIPPED (kext only)"
elif [ "$GL_PRESENT" = "1" ]; then
  [ -n "$GL_MNAME" ] && [ -n "$GL_SHA" ] && [ -n "$GL_TAR_REL" ] && [ -n "$GL_INST_REL" ] \
    || stop "manifest gl block lacks name/binary_sha256/bundle/installer (or python3 cannot read it); --no-gl installs the kext only"
  [ "$GL_MNAME" = "$GL_NAME" ] \
    || stop "manifest gl.name '$GL_MNAME' != $GL_NAME (the GL bundle name the kext publishes); --no-gl installs the kext only"
  GL_TAR="$SRC/$GL_TAR_REL"; GL_INST="$SRC/$GL_INST_REL"
  [ -f "$GL_TAR" ]  || stop "GL bundle tar missing: $GL_TAR"
  [ -f "$GL_INST" ] || stop "GL installer missing: $GL_INST"
  # the installer runs as root: it and the tar must match the bundle's SHA256SUMS
  if [ -f "$SRC/SHA256SUMS" ]; then
    for _rel in "$GL_TAR_REL" "$GL_INST_REL"; do
      _want="$(awk -v p="./$_rel" '$2 == p {print $1}' "$SRC/SHA256SUMS")"
      _got="$("$ROOT"/usr/bin/shasum -a 256 "$SRC/$_rel" | awk '{print $1}')"
      [ -n "$_want" ] || stop "SHA256SUMS has no entry for ./$_rel"
      [ "$_got" = "$_want" ] || stop "$_rel sha256 $_got != SHA256SUMS $_want"
    done
    ok "GL tar + installer match SHA256SUMS"
  else
    say "  (bundle has no SHA256SUMS: GL tar/installer not sum-checked)"
  fi
  mkdir -p "$WORK/gl"
  "$ROOT"/usr/bin/tar xf "$GL_TAR" -C "$WORK/gl" || stop "GL tar extract failed: $GL_TAR_REL"
  GL_SRC="$WORK/gl/$GL_NAME.bundle"
  [ -d "$GL_SRC" ] || stop "no $GL_NAME.bundle inside $GL_TAR_REL"
  GL_GOT="$("$ROOT"/usr/bin/shasum -a 256 "$GL_SRC/Contents/MacOS/$GL_NAME" 2>/dev/null | awk '{print $1}')"
  [ "$GL_GOT" = "$GL_SHA" ] || stop "GL binary sha256 ${GL_GOT:-<no Contents/MacOS/$GL_NAME>} != expected $GL_SHA"
  ok "GL bundle $GL_NAME sha256 $GL_GOT (installer $GL_INST_REL)"
  for _p in "$GL_REAL" "$GL_LINK"; do
    if [ -e "$_p" ] && [ ! -L "$_p" ] && [ ! -d "$_p" ]; then
      stop "$_p exists but is neither a link nor a directory; resolve it by hand or pass --no-gl"
    fi
  done
  GL_DO=1
fi

# -- STOP-IF 7: the static desktop picture tool (manifest "wallpaper" block), checked before ANY change
if [ "$WP_PRESENT" = "1" ] && [ "$NO_WP" = "1" ]; then
  say "wallpaper: the bundle ships the static-picture step but --no-wallpaper was given -> SKIPPED"
elif [ "$WP_PRESENT" = "1" ]; then
  [ -n "$WP_TOOL_REL" ] && [ -n "$WP_SETTER_REL" ] && [ -n "$WP_PIC" ] \
    || stop "manifest wallpaper block lacks tool/setter/picture (or python3 cannot read it); --no-wallpaper skips it"
  [ -f "$SRC/$WP_TOOL_REL" ]   || stop "wallpaper tool missing: $SRC/$WP_TOOL_REL"
  [ -f "$SRC/$WP_SETTER_REL" ] || stop "wallpaper setter missing: $SRC/$WP_SETTER_REL"
  if [ -f "$SRC/SHA256SUMS" ]; then
    for _rel in "$WP_TOOL_REL" "$WP_SETTER_REL"; do
      _want="$(awk -v p="./$_rel" '$2 == p {print $1}' "$SRC/SHA256SUMS")"
      _got="$("$ROOT"/usr/bin/shasum -a 256 "$SRC/$_rel" | awk '{print $1}')"
      [ -n "$_want" ] || stop "SHA256SUMS has no entry for ./$_rel"
      [ "$_got" = "$_want" ] || stop "$_rel sha256 $_got != SHA256SUMS $_want"
    done
    ok "wallpaper tool + setter match SHA256SUMS (picture $WP_PIC)"
  else
    say "  (bundle has no SHA256SUMS: wallpaper tool not sum-checked)"
  fi
  WP_DO=1
fi

if [ "$DRY_RUN" = "1" ]; then
  say "DRY-RUN: pre-install STOP-IF checks passed (id, sha, uuid, build, SIP); no changes made."
  if [ "$GL_DO" = "1" ]; then
    say "  GL: STOP-IF checks passed (SHA256SUMS, $GL_NAME sha256); after the AuxKC steps it would run:"
    say "         bash $GL_INST_REL install $GL_NAME <extracted bundle> $GL_SHA (+ retire $GL_OLD_NAMES if present)"
    if [ -L "$GL_LINK" ]; then say "  current GL: $GL_LINK -> $(readlink "$GL_LINK")"
    elif [ -d "$GL_LINK" ]; then say "  current GL: $GL_LINK (a real directory)"
    else say "  current GL: $GL_LINK absent"; fi
  fi
  [ "$WP_DO" = "1" ] && say "  wallpaper: after the GL step it would run: bash $WP_TOOL_REL apply '$WP_PIC'"
  say "  (external-symbol resolution is checked during the real install -- kmutil libraries"
  say "   needs the kext installed root:wheel under /Library/Extensions; it is fail-closed +"
  say "   reversible: an unresolved symbol aborts before the AuxKC rebuild, undo with --rollback)"
  say "  would: back up any $DEST -> $BACKUP_DIR, ditto+chown,"
  say "         kmutil clear-staging, kmutil create -n aux $KDK_FLAG, kmutil inspect verify"
  # show the CURRENT resident state (read-only)
  say "current AuxKC uniqvgpu entries:"
  "$ROOT"/usr/bin/kmutil inspect --show-kext-uuids -A "$AUX" 2>/dev/null | grep -i uniqvgpu || say "  (none in AuxKC)"
  exit 0
fi

# -- 1) record prior state for rollback, back up any existing kext
mkdir -p "$BACKUP_DIR"
TS="$(date -u +%Y%m%dT%H%M%SZ)"
PRIOR_EXISTED=0; PRIOR_BACKUP=""; PRIOR_SUMMARY="no prior kext at $DEST"
if [ -e "$DEST" ]; then
  PRIOR_UUID="$("$ROOT"/usr/bin/dwarfdump --uuid "$DEST/Contents/MacOS/"* 2>/dev/null | awk '{print $2}' | head -1)"
  PRIOR_BACKUP="$BACKUP_DIR/$(basename "$DEST").${PRIOR_UUID:-prior}.$TS"
  "$ROOT"/bin/mv "$DEST" "$PRIOR_BACKUP" || stop "could not back up existing kext"
  PRIOR_EXISTED=1
  PRIOR_SUMMARY="prior kext $(basename "$DEST") uuid=${PRIOR_UUID:-?} backed up to $PRIOR_BACKUP"
  ok "backed up existing kext -> $PRIOR_BACKUP"
fi
# back up the AuxKC *file* itself so rollback restores it byte-for-byte (the most
# faithful undo; also covers "no aux kexts remain", which kmutil cannot rebuild).
PRIOR_AUXKC=""; PRIOR_AUXKC_EXISTED=0
if [ -e "$AUX" ]; then
  PRIOR_AUXKC="$BACKUP_DIR/AuxiliaryKernelExtensions.kc.$TS"
  "$ROOT"/bin/cp -p "$AUX" "$PRIOR_AUXKC" || stop "could not back up the AuxKC"
  PRIOR_AUXKC_EXISTED=1
  ok "backed up pre-install AuxKC -> $PRIOR_AUXKC ($("$ROOT"/usr/bin/shasum -a 256 "$AUX" | awk '{print $1}'))"
fi
cat > "$ROLLBACK_STATE" <<EOF
# uniq-vgpu-guest-install rollback state ($TS)
INSTALLED_DEST="$DEST"
PRIOR_EXISTED=$PRIOR_EXISTED
PRIOR_BACKUP="$PRIOR_BACKUP"
PRIOR_AUXKC="$PRIOR_AUXKC"
PRIOR_AUXKC_EXISTED=$PRIOR_AUXKC_EXISTED
PRIOR_KDK_FLAG="$KDK_FLAG"
PRIOR_SUMMARY="$PRIOR_SUMMARY"
INSTALLED_UUID="$GOT_UUID"
INSTALLED_SHA="$GOT_SHA"
EOF
# the guest GL bundle's prior layout (both paths), recorded before anything changes;
# GL_MANAGED=1 is written last, so --rollback touches GL only if the record is complete
if [ "$GL_DO" = "1" ]; then
  gl_snapshot REAL "$GL_REAL"
  gl_snapshot LINK "$GL_LINK"
  echo "GL_MANAGED=1" >> "$ROLLBACK_STATE"
fi

# -- 2) install + fix ownership (kexts must be root:wheel)
"$ROOT"/usr/bin/ditto "$KEXTDIR" "$DEST" || stop "ditto install failed"
"$ROOT"/usr/sbin/chown -R 0:0 "$DEST"    || stop "chown root:wheel failed"
# verify the destination is byte-identical
DST_SHA="$("$ROOT"/usr/bin/shasum -a 256 "$DEST/Contents/MacOS/"* | awk '{print $1}' | head -1)"
[ "$DST_SHA" = "$GOT_SHA" ] || stop "installed binary sha $DST_SHA != source $GOT_SHA"
ok "installed to $DEST (sha $DST_SHA)"

# -- 3) external symbols must resolve against the on-disk collections (kmutil
# libraries needs the kext installed root:wheel, hence after ditto/chown). kmutil
# lists every imported symbol WITH its resolving "....kc:" target; an UNRESOLVED
# one is a mangled line lacking a ".kc:" target (we do NOT grep symbol names for
# 'error'/'undefined' -- names like setSubmissionError contain those substrings).
LIBOUT="$("$ROOT"/usr/bin/kmutil libraries -p "$DEST" --undef-symbols 2>&1)"; LRC=$?
UNRES="$(printf '%s\n' "$LIBOUT" | grep -E '^[[:space:]]*__Z' | grep -vE '\.kc:' || true)"
if [ "$LRC" -ne 0 ] \
   || printf '%s' "$LIBOUT" | grep -qE 'could not be resolved|symbol(s)? not found|not found in any'; then
  printf '%s\n' "$LIBOUT" | tail -8
  stop "kmutil libraries failed / reported unresolved symbols (rc=$LRC) -> aborting before AuxKC rebuild (restore with --rollback)"
fi
if [ -n "$UNRES" ]; then
  echo "$UNRES" | head
  stop "kext has symbols that resolve in NO on-disk collection -> aborting before AuxKC rebuild (restore with --rollback)"
fi
ok "external symbols all resolve in the on-disk .kc collections"

# -- 4) rebuild ONLY the auxiliary collection (never boot/system). Include EVERY
# kext in /Library/Extensions (the new one is now among them), so existing aux
# kexts (Wi-Fi, storage, the prior display driver) are PRESERVED -- `-p $DEST`
# alone would build an AuxKC with ONLY our kext and silently drop the rest.
"$ROOT"/usr/bin/kmutil clear-staging >/dev/null 2>&1
PK=()
for k in "$DEST_DIR"/*.kext; do [ -d "$k" ] && PK+=(-p "$k"); done
say "kmutil create -n aux ($(( ${#PK[@]} / 2 )) kext(s) in $DEST_DIR, incl. $(basename "$DEST")) $KDK_FLAG"
"$ROOT"/usr/bin/kmutil create -n aux -L -x "${PK[@]}" -B "$BOOT" -S "$SYS" -A "$AUX" $KDK_FLAG \
  || stop "kmutil create -n aux FAILED (no reboot; restore with --rollback)"
ok "AuxKC rebuilt ($(( ${#PK[@]} / 2 )) aux kext(s) preserved + the new resident)"

# -- 5) verify it is in the AuxKC
INSPECT="$("$ROOT"/usr/bin/kmutil inspect --show-kext-uuids -A "$AUX" 2>/dev/null | grep -i "$KEXT_ID")"
[ -n "$INSPECT" ] || stop "kmutil inspect does NOT show $KEXT_ID in the AuxKC (restore with --rollback)"
say "AuxKC now carries:"
echo "    $INSPECT"
AUXSHA="$("$ROOT"/usr/bin/shasum -a 256 "$AUX" | awk '{print $1}')"
ok "verified: $KEXT_ID present in AuxKC (AuxKC sha $AUXSHA)"

# -- 6) the guest GL bundle (manifest "gl" block): after the kext + AuxKC steps, before the reboot
if [ "$GL_DO" = "1" ]; then
  say "installing GL bundle: bash $GL_INST_REL install $GL_NAME <extracted bundle> $GL_SHA"
  GLOUT="$("$ROOT"/bin/bash "$GL_INST" install "$GL_NAME" "$GL_SRC" "$GL_SHA" 2>&1)"; GRC=$?
  printf '%s\n' "$GLOUT" | sed 's/^/    gl| /'
  { [ "$GRC" -eq 0 ] && printf '%s\n' "$GLOUT" | grep -qx "GPU_BUNDLE_OK $GL_NAME $GL_SHA"; } \
    || stop "GL install did not report 'GPU_BUNDLE_OK $GL_NAME $GL_SHA' (rc=$GRC); kext + AuxKC are installed, no reboot (undo both with --rollback)"
  ok "GL bundle $GL_NAME installed: $GL_LINK -> $GL_REAL (sha $GL_SHA)"
  for _old in $GL_OLD_NAMES; do
    if [ -e "$GL_LINK_DIR/$_old.bundle" ] || [ -L "$GL_LINK_DIR/$_old.bundle" ] || [ -e "$GL_REAL_DIR/$_old.bundle" ]; then
      ROUT="$("$ROOT"/bin/bash "$GL_INST" retire "$_old" 2>&1)"; RRC=$?
      printf '%s\n' "$ROUT" | sed 's/^/    gl| /'
      { [ "$RRC" -eq 0 ] && printf '%s\n' "$ROUT" | grep -qx "GPU_BUNDLE_RETIRED $_old"; } \
        || stop "retire $_old did not report 'GPU_BUNDLE_RETIRED $_old' (rc=$RRC); kext + AuxKC + $GL_NAME are installed, no reboot (undo with --rollback)"
      echo "GL_RETIRED=\"$_old\"" >> "$ROLLBACK_STATE"
      ok "retired the former GL bundle name $_old (moved to /var/db/uniqvgpu-retired)"
    fi
  done
  say "GL: the kext publishes IOGLBundleName $GL_NAME only if $GL_LINK is a directory at accelerator start -> needs the reboot"
fi

# -- 7) the static desktop picture (manifest "wallpaper" block): after the GL step; a failure is a WARN, not a STOP
if [ "$WP_DO" = "1" ]; then
  say "wallpaper: bash $WP_TOOL_REL apply '$WP_PIC'"
  WOUT="$("$ROOT"/bin/bash "$SRC/$WP_TOOL_REL" apply "$WP_PIC" 2>&1)"; WRC=$?
  printf '%s\n' "$WOUT" | sed 's/^/    wp| /'
  # the tool installed itself (agent, backups) -> --rollback reverts it, also after a partial failure
  [ -f "$WP_SUPPORT" ] && echo "WALLPAPER_MANAGED=1" >> "$ROLLBACK_STATE"
  if [ "$WRC" -eq 0 ] && printf '%s\n' "$WOUT" | grep -q '^WALLPAPER_APPLY_OK'; then
    ok "wallpaper: static picture set for logged-in users; others get it at their next login"
  else
    say "  WARN wallpaper step rc=$WRC (see wp| lines); kext + GL are installed; retry: sudo bash $SRC/$WP_TOOL_REL apply"
  fi
fi

say "INSTALL COMPLETE. Rollback anytime: sudo uniq-vgpu-guest-install --rollback"
if [ "$NO_REBOOT" = "1" ]; then
  say "reboot the guest to load the new resident kext: sudo reboot"
  exit 0
fi
if [ "$ASSUME_YES" = "1" ]; then
  say "rebooting to load the kext..."
  "$ROOT"/sbin/reboot
else
  printf 'guest-install: reboot now to load the kext? [y/N] '
  read -r ans
  case "$ans" in y|Y|yes) "$ROOT"/sbin/reboot ;; *) say "not rebooting; run: sudo reboot" ;; esac
fi
exit 0
