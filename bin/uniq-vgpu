#!/usr/bin/env python3
# SPDX-License-Identifier: GPL-2.0-or-later
"""uniq-vgpu: one-command live-update for the uniq-vGPU host stack.

Increment 3 of the fixed-resident-kext / variable-host-backend architecture
(see evidence/runs/applegva-warmswap-20261116/WARM-SWAP-ARCHITECTURE.md). A THIN
wrapper over the PROVEN increment-1 warm-swap primitives `qdevctl device-swap`
and `qdevctl device-abi`; it ORCHESTRATES, it does not reimplement them.

  uniq-vgpu update <bundle> [TARGET] [--dry-run] [--reset hotplug] ...
                 verify -> envelope ABI-gate (warm vs reboot) -> stage ->
                 device-swap -> HEALTH GATE -> commit; auto-rollback on failure.
  uniq-vgpu rollback [TARGET]        symmetric warm swap back to the previous bundle
  uniq-vgpu status  [TARGET]         active bundle + envelope/ABI + ioreg triplet + health

TARGET selects the device the primitives act on, and is passed straight through
to qdevctl:
  --control PATH        a qdev-host --control socket (raw/off-VM/bring-up harness)
  VMID ID               a PVE qdev-host device (resolves its control socket)

A BUNDLE is a directory holding:
  uniq-vgpu-bundle.json   manifest: {schema,name,version,envelope,kind,backing}
  SHA256SUMS              sha256 of every bundle file (verify gate; verify.sh-style)
  <payload...>            e.g. backing/<name>.so  (the VARIABLE backing to swap in)

The ABI-gate compares the bundle's ENVELOPE tag to the running resident's
envelope (read live via `qdevctl device-abi`). SAME envelope => WARM path (even
if the bundle ADDS commands/capabilities); DIFFERENT envelope => REBOOT required
(the frozen conduit/handshake changed) -- staged, never silently rebooted.
"""
import argparse, hashlib, json, os, shutil, subprocess, sys, tempfile, time

BUNDLE_MANIFEST = "uniq-vgpu-bundle.json"
BUNDLE_SCHEMA = "uniq-vgpu-bundle/1"
SHA256SUMS = "SHA256SUMS"
DEFAULT_STATE_DIR = os.environ.get("UNIQ_VGPU_STATE_DIR", "/var/lib/uniq-vgpu")

# distinct, scriptable exit codes
EX_OK = 0
EX_ERR = 1            # usage / verify / primitive error
EX_HEALTH = 3        # health gate failed (auto-rollback performed)
EX_REBOOT = 20       # update staged but needs a guest reboot (envelope changed)
EX_GUEST = 21        # host warm-updated, but a guest kext install is still required
EX_PENDING = 22      # identity swapped, but the REAL backend-process reload is pending (lane)


class UpdateError(Exception):
    pass


# --------------------------------------------------------------- small helpers
def log(msg):
    print(msg, flush=True)


def sha256_file(path):
    h = hashlib.sha256()
    with open(path, "rb") as f:
        for chunk in iter(lambda: f.read(1 << 20), b""):
            h.update(chunk)
    return h.hexdigest()


def find_qdevctl(explicit):
    if explicit:
        return explicit
    # next to this script's repo (bin/uniq-vgpu -> pve/qdevctl), then PATH, then PVE install
    here = os.path.dirname(os.path.abspath(__file__))
    for cand in (os.path.join(here, "..", "pve", "qdevctl"),
                 shutil.which("qdevctl"),
                 "/usr/sbin/qdevctl", "/usr/bin/qdevctl"):
        if cand and os.path.exists(cand):
            return os.path.abspath(cand)
    raise UpdateError("qdevctl not found (use --qdevctl PATH)")


# --------------------------------------------------------- qdevctl primitive wrappers
class Primitives:
    """Thin shell-out wrapper over the increment-1 warm-swap primitives."""

    def __init__(self, qdevctl, target):
        self.qdevctl = qdevctl
        self.target = list(target)   # ['--control', PATH]  or  ['VMID', 'ID']

    def _run(self, *extra):
        cmd = [sys.executable, self.qdevctl] + list(extra)
        p = subprocess.run(cmd, capture_output=True, text=True)
        return p.returncode, p.stdout.strip(), p.stderr.strip()

    def device_abi(self):
        """-> dict(envelope, plugin, version, qdp_abi, raw)."""
        rc, out, err = self._run("device-abi", *self.target)
        if rc != 0:
            raise UpdateError(f"device-abi failed: {err or out}")
        d = {"raw": out}
        for tok in out.split():
            if "=" in tok:
                k, v = tok.split("=", 1)
                d[k] = v
        if "envelope" not in d:
            raise UpdateError(f"device-abi: no envelope in reply: {out!r}")
        return d

    def device_swap(self, backing, reset=None):
        args = ["device-swap"]
        # --control must precede positionals; VMID ID are positionals before BACKING
        if self.target and self.target[0] == "--control":
            args += self.target + [backing]
        else:
            args += self.target + [backing]
        if reset:
            args += ["--reset", reset]
        rc, out, err = self._run(*args)
        if rc != 0:
            raise UpdateError(f"device-swap {backing} failed: {err or out}")
        return out


# ------------------------------------------------------------------- the bundle
class Bundle:
    def __init__(self, path):
        self.path = os.path.abspath(path)
        if not os.path.isdir(self.path):
            raise UpdateError(f"bundle not a directory: {self.path}")
        mpath = os.path.join(self.path, BUNDLE_MANIFEST)
        if not os.path.exists(mpath):
            raise UpdateError(f"not a uniq-vgpu bundle (no {BUNDLE_MANIFEST}): {self.path}")
        with open(mpath) as f:
            self.manifest = json.load(f)
        for k in ("name", "version", "envelope", "kind"):
            if k not in self.manifest:
                raise UpdateError(f"bundle manifest missing '{k}'")

    @property
    def name(self):
        return self.manifest["name"]

    @property
    def envelope(self):
        return self.manifest["envelope"]

    @property
    def kind(self):
        return self.manifest["kind"]

    @property
    def version(self):
        return self.manifest["version"]

    @property
    def backend_reload(self):
        # 'device-swap' (in-process backing .so / identity descriptor) | 'backend-process'
        # (REAL renderer libmlapi/QMetal/air -- needs a qdev-host backend-process reload).
        return self.manifest.get("backend_reload", "device-swap")

    def backing_path(self):
        b = self.manifest.get("backing")
        if not b:
            raise UpdateError(f"bundle '{self.name}' has no 'backing' (kind={self.kind})")
        p = os.path.join(self.path, b)
        if not os.path.exists(p):
            raise UpdateError(f"bundle backing missing on disk: {b}")
        return p

    # ------- guest kext payload (apply): the FIXED resident driver, if the
    # bundle ships one. None => host-only bundle (pure warm backend swap).
    @property
    def kext(self):
        return self.manifest.get("kext")

    def kext_path(self):
        k = self.kext
        if not k or not k.get("bundle"):
            return None
        p = os.path.join(self.path, k["bundle"])
        if not os.path.exists(p):
            raise UpdateError(f"bundle kext payload missing on disk: {k['bundle']}")
        return p

    # ------- verify: sha of every bundle file (verify.sh-style), portable core
    def verify(self):
        """Check every file against SHA256SUMS. Returns (ok, lines)."""
        sums = os.path.join(self.path, SHA256SUMS)
        if not os.path.exists(sums):
            raise UpdateError(f"bundle has no {SHA256SUMS}")
        out = []
        ok = True
        with open(sums) as f:
            for line in f:
                line = line.rstrip("\n")
                if not line.strip():
                    continue
                want, _, rel = line.partition("  ")
                rel = rel.lstrip("./") if rel else rel
                fp = os.path.join(self.path, rel)
                if not os.path.exists(fp):
                    out.append(f"MISSING  {rel}")
                    ok = False
                    continue
                got = sha256_file(fp)
                if got == want:
                    out.append(f"OK       {rel}")
                else:
                    out.append(f"MISMATCH {rel} (want {want[:12]} got {got[:12]})")
                    ok = False
        # A layout-specific release verify.sh (ldd gate) is honored when present.
        vsh = os.path.join(self.path, "tools", "verify.sh")
        if os.path.exists(vsh):
            p = subprocess.run(["sh", vsh, self.path], capture_output=True, text=True)
            out.append(f"verify.sh: {'OK' if p.returncode == 0 else 'FAIL'} "
                       f"({(p.stdout + p.stderr).strip().splitlines()[-1] if (p.stdout+p.stderr).strip() else ''})")
            ok = ok and p.returncode == 0
        return ok, out


# ------------------------------------------------------------------- state file
class State:
    """Durable record of the active + previous bundle for commit/rollback."""

    def __init__(self, state_dir):
        self.dir = os.path.abspath(state_dir)
        self.file = os.path.join(self.dir, "state.json")
        self.stage_dir = os.path.join(self.dir, "backings")
        self.data = {}
        if os.path.exists(self.file):
            with open(self.file) as f:
                self.data = json.load(f)

    def save(self):
        os.makedirs(self.dir, exist_ok=True)
        tmp = self.file + ".tmp"
        with open(tmp, "w") as f:
            json.dump(self.data, f, indent=2)
            f.flush()
            os.fsync(f.fileno())
        os.replace(tmp, self.file)

    def stage_backing(self, src, name):
        """Copy a backing alongside the active one, atomically. Returns dst path."""
        os.makedirs(self.stage_dir, exist_ok=True)
        digest = sha256_file(src)[:16]
        dst = os.path.join(self.stage_dir, f"{name}-{digest}{os.path.splitext(src)[1]}")
        fd, tmp = tempfile.mkstemp(dir=self.stage_dir, prefix=".stage-")
        os.close(fd)
        shutil.copyfile(src, tmp)
        with open(tmp, "rb") as f:
            os.fsync(f.fileno())
        os.replace(tmp, dst)
        return dst


# ------------------------------------------------------------------ health gate
def read_health(args):
    """Collect counters from the configured source. Returns dict (any subset of
    qmu_error, panics, gpu_hang, gpuRestart) or {} if no source. Missing keys are
    'not applicable', present keys are gated."""
    counters = {}
    if args.health_cmd:
        p = subprocess.run(args.health_cmd, shell=True, capture_output=True, text=True)
        txt = p.stdout.strip()
        parsed = None
        try:
            parsed = json.loads(txt)
        except Exception:
            parsed = None
        if isinstance(parsed, dict):
            for k, v in parsed.items():
                counters[_norm_key(k)] = int(v)
        else:
            for tok in txt.replace(",", " ").split():
                if "=" in tok:
                    k, v = tok.split("=", 1)
                    try:
                        counters[_norm_key(k)] = int(v)
                    except ValueError:
                        pass
    if args.health_log and os.path.exists(args.health_log):
        txt = open(args.health_log, errors="replace").read()
        low = txt.lower()
        counters.setdefault("qmu_error", low.count("qmu error"))
        counters.setdefault("panics", _count_words(low, ("panic",)))
        counters.setdefault("gpu_hang", low.count("gpu_hang") + low.count("gpu hang"))
        counters.setdefault("gpuRestart", _count_substr(txt, ("gpurestart",)))
    return counters


def _norm_key(k):
    k = k.strip().lower().replace(" ", "_").replace("-", "_")
    if k in ("gpurestart", "gpu_restart"):
        return "gpuRestart"
    if k in ("qmu_error", "qmu_errors", "errors", "error"):
        return "qmu_error"
    if k in ("panic", "panics"):
        return "panics"
    if k in ("gpu_hang", "hang", "hangs"):
        return "gpu_hang"
    return k


def _count_words(low, words):
    import re
    n = 0
    for w in words:
        n += len(re.findall(r"\b" + re.escape(w) + r"\b", low))
    return n


def _count_substr(txt, subs):
    low = txt.lower()
    return sum(low.count(s) for s in subs)


def health_gate(pre, post, expect_gpurestart_max):
    """Apply the architecture health gate. Returns (ok, lines)."""
    lines = []
    ok = True
    for key, label in (("qmu_error", "QMU ERROR"), ("panics", "panics"), ("gpu_hang", "gpu_hang")):
        v = post.get(key)
        if v is None:
            lines.append(f"  {label}: n/a (no source)")
        elif v == 0:
            lines.append(f"  {label}: 0  OK")
        else:
            lines.append(f"  {label}: {v}  FAIL (must be 0)")
            ok = False
    # gpuRestart: a warm swap may cause one controlled restart (the blink); more
    # than expect-max, or a decrease, is a failure.
    pr = post.get("gpuRestart")
    if pr is None:
        lines.append("  gpuRestart: n/a (no source)")
    else:
        base = (pre or {}).get("gpuRestart", 0)
        delta = pr - base
        if 0 <= delta <= expect_gpurestart_max:
            lines.append(f"  gpuRestart: {base}->{pr} (+{delta})  OK (expected 0..{expect_gpurestart_max})")
        else:
            lines.append(f"  gpuRestart: {base}->{pr} ({delta:+d})  FAIL (expected +0..{expect_gpurestart_max})")
            ok = False
    return ok, lines


# ------------------------------------------------------------------- ioreg triplet
def read_ioreg_triplet(args):
    """Guest-side version triplet for `status`. Off-VM this is unavailable."""
    txt = None
    if args.ioreg_cmd:
        p = subprocess.run(args.ioreg_cmd, shell=True, capture_output=True, text=True)
        txt = p.stdout
    elif args.ioreg_file and os.path.exists(args.ioreg_file):
        txt = open(args.ioreg_file, errors="replace").read()
    if not txt:
        return None
    trip = {}
    for line in txt.splitlines():
        line = line.strip()
        for key in ("AGVAEnvelopeVersion", "AGVAGuestDriverVersion", "AGVAHostDriverVersion",
                    "AGVAHandshakeGeneration", "EnvelopeVersion", "GuestDriverVersion",
                    "HostDriverVersion", "HandshakeGeneration",
                    "UniqVGPUBackendVersion"):
            if key in line:
                _, _, val = line.partition("=")
                trip[key] = val.strip().strip('"') or line
    return trip or None


# --------------------------------------------------------------------- commands
def resolve_target(args):
    if args.control:
        return ["--control", args.control]
    if args.vmid and args.id:
        return [str(args.vmid), args.id]
    raise UpdateError("need a target: --control PATH, or VMID ID")


def run_host_update(args, prim, st, bundle, dry_run):
    """HOST side: ABI-gate -> (dry-run plan | reboot staging | warm swap+health+commit).

    Returns (exit_code, info) where info has keys: warm(bool), running_env,
    committed(bool), kind('dryrun'|'reboot'|'warm'|'warm-rollback'), staged.
    The log output + exit codes are the increment-3 `update` contract, reused
    verbatim by both `update` and `apply`."""
    # ABI-GATE
    abi = prim.device_abi()
    running_env = abi["envelope"]
    warm = (bundle.envelope == running_env)
    log(f"abi-gate: bundle envelope={bundle.envelope}  resident envelope={running_env}  "
        f"=> {'WARM (in-place swap)' if warm else 'REBOOT required (envelope changed)'}")

    backing = bundle.backing_path() if bundle.kind == "host-backend" else None
    info = {"warm": warm, "running_env": running_env, "committed": False,
            "kind": None, "staged": None}

    # DRY-RUN
    if dry_run:
        log("")
        log("DRY-RUN plan:")
        log(f"  changes: resident backend -> bundle '{bundle.name}' {bundle.version}")
        if warm:
            log(f"  path: WARM  (stage {os.path.basename(backing) if backing else '(no backing)'} "
                f"-> qdevctl device-swap{' --reset ' + args.reset if args.reset else ''} "
                f"-> health gate -> commit)")
            if bundle.backend_reload == "backend-process":
                if getattr(args, "backend_reload_cmd", None):
                    log("  backend reload: REAL renderer (libmlapi/QMetal/air) reloaded via "
                        "--backend-reload-cmd (qdev-host backend-process restart + vfio reconnect)")
                else:
                    log("  backend reload: device-swap updates ONLY the identity; the REAL renderer "
                        "reload is PENDING the backend-process swap lane (pass --backend-reload-cmd)")
            else:
                log("  backend reload: in-process device-swap of the backing .so / identity descriptor")
            log("  on health-gate failure: AUTO-ROLLBACK (symmetric device-swap to previous)")
        else:
            log("  path: REBOOT  (stage host + guest; one guest reboot required; nothing swapped live)")
        log(f"  rollback-to on failure: {st.data.get('active', {}).get('backing', 'A (boot default)')}")
        info["kind"] = "dryrun"
        return EX_OK, info

    # REBOOT path
    if not warm:
        staged = st.stage_backing(backing, bundle.name) if backing else None
        st.data["pending_reboot"] = {
            "bundle": bundle.name, "version": bundle.version,
            "envelope": bundle.envelope, "staged_backing": staged,
            "resident_envelope": running_env, "at": time.strftime("%Y-%m-%dT%H:%M:%S%z"),
        }
        st.save()
        log("")
        log("=== REBOOT REQUIRED ===")
        log(f"This update changes the envelope/ABI ({running_env} -> {bundle.envelope}).")
        log("The FROZEN conduit/handshake differs, so a warm swap is NOT safe.")
        log("Host (and guest) components are staged; apply with ONE guest reboot:")
        log(f"  staged backing: {staged}")
        log("No live swap was performed. Reboot the guest to switch.")
        info["kind"] = "reboot"
        info["staged"] = staged
        return EX_REBOOT, info

    # WARM path
    if not backing:
        raise UpdateError(f"warm path needs a host-backend backing; kind={bundle.kind}")
    prev_backing = st.data.get("active", {}).get("backing") or args.rollback_to or "A"
    staged = st.stage_backing(backing, bundle.name)
    info["staged"] = staged
    log(f"staged: {staged}  (previous active: {prev_backing})")

    pre = read_health(args) if not args.no_health else {}
    log(f"health baseline: {pre or '(none)'}")

    log(f"device-swap -> {os.path.basename(staged)}" + (f" --reset {args.reset}" if args.reset else ""))
    swap_out = prim.device_swap(staged, reset=args.reset)
    log(f"  {swap_out}")

    # REAL-BACKEND RELOAD ROUTING.
    # `device-swap` reloads an in-process plugin-.so backend (apple-videotoolbox)
    # or swaps the apple-pvg IDENTITY descriptor (tag/backend_version/hold_ms). It
    # does NOT reload the display-GPU's real renderer (libmlapi/QMetal/air), which
    # is RTLD_NODELETE-pinned for process life. A bundle that changes the real
    # renderer declares backend_reload="backend-process": the renderer reload must
    # go through a qdev-host backend-process restart on the same vfio-user socket
    # (+ vfio reconnect, which the warm-swap resident survives, no guest reboot).
    info["backend_reload"] = bundle.backend_reload
    info["backend_pending"] = False
    if bundle.backend_reload == "backend-process":
        reload_cmd = getattr(args, "backend_reload_cmd", None)
        if reload_cmd:
            log(f"real-backend reload: running backend-process reload hook")
            p = subprocess.run(reload_cmd, shell=True, capture_output=True, text=True)
            log(f"  reload hook rc={p.returncode}: {(p.stdout + p.stderr).strip().splitlines()[-1] if (p.stdout+p.stderr).strip() else ''}")
            if p.returncode != 0:
                log("  backend-process reload FAILED -> treating as health failure")
                try:
                    out = prim.device_swap(prev_backing)
                    log(f"  rolled back identity: {out}")
                except UpdateError as e:
                    log(f"  rollback ALSO failed: {e}")
                    raise
                info["kind"] = "warm-rollback"
                return EX_HEALTH, info
        else:
            info["backend_pending"] = True
            log("")
            log("  *** REAL-BACKEND RELOAD PENDING ***")
            log("  device-swap updated ONLY the identity descriptor (tag/backend_version).")
            log("  The real host renderer (libmlapi/QMetal/air) is RTLD_NODELETE-pinned and")
            log("  was NOT reloaded. Route it through the qdev-host backend-process swap")
            log("  (process restart on the same vfio-user socket + vfio reconnect; the")
            log("  warm-swap resident survives, no guest reboot) -- pending lane")
            log("  L-WARMSWAP-BACKEND-PROC. Provide its mechanism via --backend-reload-cmd.")

    # HEALTH GATE
    if args.no_health:
        log("health gate: SKIPPED (--no-health)")
        hok = True
    else:
        if args.health_settle:
            time.sleep(args.health_settle)
        # verify the device still answers (envelope intact) as part of health
        try:
            abi2 = prim.device_abi()
            abi_alive = (abi2["envelope"] == running_env)
        except UpdateError:
            abi_alive = False
        post = read_health(args)
        hok, hlines = health_gate(pre, post, args.expect_gpurestart)
        log(f"health gate ({post or 'no counters'}):")
        for l in hlines:
            log(l)
        log(f"  device-abi still responding, envelope intact: {'OK' if abi_alive else 'FAIL'}")
        hok = hok and abi_alive

    if hok:
        st.data["active"] = {"bundle": bundle.name, "version": bundle.version,
                             "envelope": bundle.envelope, "backing": staged,
                             "at": time.strftime("%Y-%m-%dT%H:%M:%S%z")}
        st.data["previous"] = {"backing": prev_backing}
        st.data.pop("pending_reboot", None)
        if info.get("backend_pending"):
            st.data["pending_backend_reload"] = {
                "bundle": bundle.name, "version": bundle.version,
                "at": time.strftime("%Y-%m-%dT%H:%M:%S%z")}
        st.save()
        log("")
        if info.get("backend_pending"):
            log(f"=== IDENTITY SWAPPED for '{bundle.name}' {bundle.version} (no guest reboot); "
                f"REAL renderer reload PENDING backend-process swap ===")
            info["kind"] = "warm"
            return EX_PENDING, info
        log(f"=== COMMITTED: resident now serving '{bundle.name}' {bundle.version} (no guest reboot) ===")
        info["committed"] = True
        info["kind"] = "warm"
        return EX_OK, info

    # AUTO-ROLLBACK
    log("")
    log("=== HEALTH GATE FAILED -> AUTO-ROLLBACK ===")
    try:
        out = prim.device_swap(prev_backing)
        log(f"  rolled back: {out}")
    except UpdateError as e:
        log(f"  rollback ALSO failed: {e}")
        raise
    log(f"resident reverted to previous backing ({prev_backing}); update aborted.")
    info["kind"] = "warm-rollback"
    return EX_HEALTH, info


def cmd_update(args):
    prim = Primitives(find_qdevctl(args.qdevctl), resolve_target(args))
    st = State(args.state_dir)

    if args.rollback:
        return _do_rollback(args, prim, st)

    bundle = Bundle(args.bundle)
    log(f"bundle: {bundle.name} {bundle.version}  envelope={bundle.envelope}  kind={bundle.kind}")

    # 1. VERIFY
    ok, vlines = bundle.verify()
    for l in vlines:
        log(f"  verify {l}")
    if not ok:
        raise UpdateError("bundle verification FAILED")
    log("verify: OK")

    rc, _info = run_host_update(args, prim, st, bundle, args.dry_run)
    return rc


# ======================================================================= apply
# `apply` is the one-shot install/update entry point. It drives the HOST side
# (warm swap or reboot-staging, via run_host_update) AND the GUEST side (the
# FIXED resident kext): push+install over an exec channel if one exists, else
# print the exact `sudo uniq-vgpu-guest-install ...` one-liner for the user.

class GuestSSH:
    """An SSH exec channel to the guest (auto-detected from --guest-ssh)."""

    def __init__(self, spec, ssh_opts=None):
        # spec: [user@]host[:port]
        user_host, _, port = spec.partition(":")
        self.port = port or "22"
        self.user_host = user_host
        self.ssh_opts = ssh_opts or ["-o", "BatchMode=yes", "-o", "ConnectTimeout=8",
                                     "-o", "StrictHostKeyChecking=accept-new"]

    def desc(self):
        return f"ssh {self.user_host} (port {self.port})"

    def exec(self, remote_cmd, timeout=120):
        cmd = ["ssh"] + self.ssh_opts + ["-p", self.port, self.user_host, remote_cmd]
        p = subprocess.run(cmd, capture_output=True, text=True, timeout=timeout)
        return p.returncode, p.stdout, p.stderr

    def push(self, local, remote, timeout=120):
        cmd = ["scp"] + self.ssh_opts + ["-P", self.port, local, f"{self.user_host}:{remote}"]
        p = subprocess.run(cmd, capture_output=True, text=True, timeout=timeout)
        if p.returncode != 0:
            raise UpdateError(f"scp {local} failed: {(p.stderr or p.stdout).strip()}")


def detect_guest_channel(args):
    """Auto-detect a guest exec channel. Returns a channel or None.
    Precedence: explicit --guest-ssh. (qemu-agent hook left for a QGA target.)"""
    if getattr(args, "guest_ssh", None):
        return GuestSSH(args.guest_ssh)
    return None


def read_guest_resident_kext(channel, args):
    """Read the guest's live resident-kext identity. Returns dict or None.
    Off-channel, honor --guest-kextstat-file (a captured `kmutil inspect`/kextstat)."""
    txt = None
    if channel:
        try:
            rc, out, err = channel.exec(
                "kmutil inspect --show-kext-uuids -A "
                "/Library/KernelCollections/AuxiliaryKernelExtensions.kc 2>/dev/null "
                "| grep -i uniqvgpu || true")
            txt = out
        except Exception as e:
            log(f"  (guest probe failed: {e})")
            return None
    elif getattr(args, "guest_kextstat_file", None) and os.path.exists(args.guest_kextstat_file):
        txt = open(args.guest_kextstat_file, errors="replace").read()
    if not txt or not txt.strip():
        return None
    # a line like: dev.uniqvgpu.driver  0.1.0  /Library/.../UniqVGPU.kext  (UUID)
    import re
    m = re.search(r"([0-9A-Fa-f]{8}-[0-9A-Fa-f-]{27,})", txt)
    return {"present": True, "raw": txt.strip(), "uuid": (m.group(1).upper() if m else None)}


def cmd_apply(args):
    prim = Primitives(find_qdevctl(args.qdevctl), resolve_target(args))
    st = State(args.state_dir)

    if args.rollback:
        log("apply --rollback: HOST side (symmetric warm swap to previous backing)")
        rc = _do_rollback(args, prim, st)
        log("")
        log("GUEST side: the resident kext is FIXED across warm swaps and was NOT")
        log("changed by a warm apply, so nothing to roll back in the guest.")
        log("If a previous apply did a KEXT change (reboot path), revert it in the guest:")
        log("  sudo uniq-vgpu-guest-install --rollback")
        return rc

    bundle = Bundle(args.bundle)
    log(f"bundle: {bundle.name} {bundle.version}  envelope={bundle.envelope}  kind={bundle.kind}"
        + (f"  kext={bundle.kext.get('id')}" if bundle.kext else "  (host-only, no kext)"))

    # 1. VERIFY
    ok, vlines = bundle.verify()
    for l in vlines:
        log(f"  verify {l}")
    if not ok:
        raise UpdateError("bundle verification FAILED")
    log("verify: OK")

    # 2. optional unit stage/switch (PVE VMID target): repoint the device unit at
    # the staged host bundle so a later (re)start uses this backend. Off-VM
    # (--control) the running harness IS the unit, so this is a no-op note.
    if args.host_bundle_dir:
        log(f"host-stage: bundle host libs staged at {args.host_bundle_dir}")
        if not args.control:
            log(f"  unit-switch: point {args.vmid}-{args.id or 'pvg0'} --plugin at "
                f"{args.host_bundle_dir} (systemctl daemon-reload) for the next (re)start")

    # 3. HOST side: warm swap or reboot-staging
    log("")
    log("--- HOST side ---")
    host_rc, info = run_host_update(args, prim, st, bundle, args.dry_run)

    # 4. GUEST side: the FIXED resident kext
    log("")
    log("--- GUEST side (resident kext) ---")
    guest_required = False
    guest_done = False
    guest_oneliner = None

    if not bundle.kext:
        log("bundle ships NO kext (host-only backend update); guest untouched.")
    else:
        k = bundle.kext
        kp = bundle.kext_path()
        channel = detect_guest_channel(args)
        running = read_guest_resident_kext(channel, args) if (channel or args.guest_kextstat_file) else None
        want_uuid = (k.get("uuid") or "").upper()

        if running and want_uuid and running.get("uuid") == want_uuid:
            log(f"guest resident kext already current: {k.get('id')} ({want_uuid}) -- no guest action")
        else:
            guest_required = True
            if running:
                log(f"guest resident kext differs ({running.get('uuid')}) from bundle "
                    f"({want_uuid or k.get('binary_sha256','?')[:12]}) -> kext install/update needed")
            else:
                log(f"guest resident kext not detected -> kext install needed "
                    f"({k.get('id')} {want_uuid or ''})")

            # the exact one-liner the user runs IN the guest (kext relpath in bundle)
            guest_oneliner = f"sudo uniq-vgpu-guest-install {os.path.basename(kp)}"

            if args.dry_run:
                log(f"  DRY-RUN: would {'push+install over ' + channel.desc() if channel and not args.no_guest_exec else 'print the guest one-liner'}")
            elif channel and not args.no_guest_exec:
                log(f"exec channel: {channel.desc()} -> pushing kext + running guest-install remotely")
                guest_done = _push_and_install_guest(channel, kp, k, args)
            else:
                log("no guest exec channel (auto-detect found none) -> run this IN the guest:")
                log(f"  1) copy the kext into the guest, e.g.:")
                log(f"       scp {kp} <guest>:~/{os.path.basename(kp)}")
                log(f"  2) {guest_oneliner}")

    # 5. VERDICT
    log("")
    log("=== apply verdict ===")
    if args.dry_run:
        plan = "WARM (no reboot)" if info["warm"] else "REBOOT (envelope changed)"
        log(f"  host: {plan}")
        if info["warm"] and bundle.backend_reload == "backend-process" and not getattr(args, "backend_reload_cmd", None):
            log("  host backend: REAL renderer reload PENDING backend-process swap lane (identity-only via device-swap)")
        log(f"  guest kext: {'install required' if guest_required else 'no change'}")
        if guest_required and guest_oneliner:
            log(f"  guest command: {guest_oneliner}")
        return EX_OK

    if not info["warm"]:
        # reboot path: host staged, guest kext + reboot required
        log("  REBOOT REQUIRED (envelope/ABI changed): nothing was swapped live.")
        if bundle.kext:
            log(f"  Install the guest kext then reboot: {guest_oneliner or 'sudo uniq-vgpu-guest-install <kext>'}")
        log("  Re-run apply (or start the VM) after the guest reboot to serve the new envelope.")
        return EX_REBOOT

    if host_rc == EX_HEALTH:
        log("  HOST health gate FAILED -> auto-rolled-back; guest untouched.")
        return EX_HEALTH

    # host identity swapped, but the REAL renderer reload is pending the backend-process lane
    if host_rc == EX_PENDING or info.get("backend_pending"):
        log("  HOST: identity descriptor swapped (no reboot), but the REAL renderer reload")
        log("  (libmlapi/QMetal/air) is PENDING the qdev-host backend-process swap lane.")
        log("  Re-run with --backend-reload-cmd <mechanism> once that lane lands to reload the renderer live.")
        if guest_required:
            log(f"  GUEST KEXT also required: {guest_oneliner}")
        return EX_PENDING

    # host warm-committed
    if guest_done:
        log("  WARM-UPDATED (host, no reboot) + guest kext installed over the exec channel.")
        log("  Reboot the guest to load the new resident kext (host backend already live).")
        return EX_OK
    if guest_required:
        log("  WARM-UPDATED (host, no reboot). GUEST KEXT INSTALL REQUIRED:")
        log(f"    run in the guest:  {guest_oneliner}")
        return EX_GUEST
    log("  WARM-UPDATED, no reboot (host backend swapped; resident kext already current).")
    return EX_OK


def _push_and_install_guest(channel, kext_payload, kmeta, args):
    """Push the kext payload + the guest-install script and run it under sudo,
    forwarding the bundle's expected sha/uuid/id so the guest STOP-IF gates fire."""
    here = os.path.dirname(os.path.abspath(__file__))
    installer = os.path.join(here, "uniq-vgpu-guest-install")
    rpayload = f"/tmp/{os.path.basename(kext_payload)}"
    rinstaller = "/tmp/uniq-vgpu-guest-install"
    gate = ""
    if kmeta.get("binary_sha256"):
        gate += f" --expect-sha {kmeta['binary_sha256']}"
    if kmeta.get("uuid"):
        gate += f" --expect-uuid {kmeta['uuid']}"
    if kmeta.get("id"):
        gate += f" --id {kmeta['id']}"
    try:
        channel.push(kext_payload, rpayload)
        if os.path.exists(installer):
            channel.push(installer, rinstaller)
        reboot_flag = "" if args.guest_reboot else "--no-reboot"
        rc, out, err = channel.exec(
            f"chmod +x {rinstaller}; sudo {rinstaller} {rpayload} --yes {reboot_flag}{gate}",
            timeout=600)
        for line in (out or "").splitlines():
            log(f"    guest| {line}")
        if rc != 0:
            for line in (err or "").splitlines():
                log(f"    guest-err| {line}")
            log(f"  guest-install returned rc={rc}")
            return False
        return True
    except Exception as e:
        log(f"  guest push/install failed: {e}")
        return False


def _do_rollback(args, prim, st):
    active = st.data.get("active")
    prev = st.data.get("previous", {}).get("backing", "A")
    if not active:
        log("no recorded active bundle; rolling back to boot default 'A'")
    else:
        log(f"rolling back '{active['bundle']}' {active['version']} -> previous backing {prev}")
    pre = read_health(args) if not args.no_health else {}
    out = prim.device_swap(prev, reset=args.reset)
    log(f"  {out}")
    hok = True
    if not args.no_health:
        if args.health_settle:
            time.sleep(args.health_settle)
        post = read_health(args)
        hok, hlines = health_gate(pre, post, args.expect_gpurestart)
        log("health gate:")
        for l in hlines:
            log(l)
    if not hok:
        log("WARNING: health gate failed after rollback (resident state uncertain)")
    # swap active/previous bookkeeping
    if active:
        st.data["previous"] = {"backing": active["backing"]}
    st.data["active"] = {"bundle": "(rolled-back)", "version": "", "envelope": "",
                         "backing": prev, "at": time.strftime("%Y-%m-%dT%H:%M:%S%z")}
    st.save()
    log("rollback complete." if hok else "rollback done (health uncertain).")
    return EX_OK if hok else EX_HEALTH


def cmd_rollback(args):
    prim = Primitives(find_qdevctl(args.qdevctl), resolve_target(args))
    st = State(args.state_dir)
    return _do_rollback(args, prim, st)


def cmd_status(args):
    prim = Primitives(find_qdevctl(args.qdevctl), resolve_target(args))
    st = State(args.state_dir)
    abi = prim.device_abi()
    log("uniq-vgpu status")
    log(f"  resident (host, live):  envelope={abi.get('envelope')}  plugin={abi.get('plugin')}  "
        f"version={abi.get('version')}  qdp_abi={abi.get('qdp_abi')}")
    active = st.data.get("active")
    if active:
        log(f"  active bundle:          {active.get('bundle')} {active.get('version')}  "
            f"(envelope={active.get('envelope')}, swapped {active.get('at')})")
        log(f"  backing:                {active.get('backing')}")
    else:
        log("  active bundle:          (boot default; no uniq-vgpu update applied)")
    if st.data.get("pending_reboot"):
        pr = st.data["pending_reboot"]
        log(f"  PENDING REBOOT:         {pr['bundle']} {pr['version']} (envelope {pr['envelope']}) staged")
    if st.data.get("pending_backend_reload"):
        pb = st.data["pending_backend_reload"]
        log(f"  PENDING BACKEND RELOAD: {pb['bundle']} {pb['version']} identity swapped; real renderer "
            f"reload via backend-process lane (swapped {pb['at']})")
    trip = read_ioreg_triplet(args)
    if trip:
        log("  guest ioreg triplet:")
        for k, v in trip.items():
            log(f"      {k} = {v}")
    else:
        log("  guest ioreg triplet:    (guest offline / off-VM; host envelope above is the gate value)")
    if not args.no_health:
        h = read_health(args)
        log(f"  health:                 {h or '(no source configured)'}")
    return EX_OK


# ------------------------------------------------------------------------ parse
def add_target_opts(p):
    p.add_argument("--control", help="qdev-host --control socket (raw/off-VM target)")
    p.add_argument("--vmid", type=int, help="PVE VMID (with ID)")
    p.add_argument("--id", help="PVE qdev-host device id (with --vmid)")
    p.add_argument("--qdevctl", help="path to qdevctl (default: auto-detect)")
    p.add_argument("--state-dir", default=DEFAULT_STATE_DIR,
                   help=f"active/previous bundle state (default {DEFAULT_STATE_DIR})")


def add_health_opts(p):
    p.add_argument("--health-log", help="scan a log file for QMU ERROR / panic / gpu_hang / gpuRestart")
    p.add_argument("--health-cmd", help="run a command; parse key=val or JSON counters")
    p.add_argument("--expect-gpurestart", type=int, default=1,
                   help="max allowed gpuRestart delta across a warm swap (default 1)")
    p.add_argument("--health-settle", type=float, default=0.0,
                   help="seconds to wait after a swap before reading health")
    p.add_argument("--no-health", action="store_true", help="skip the health gate (not recommended)")


def main(argv=None):
    ap = argparse.ArgumentParser(prog="uniq-vgpu", description=__doc__,
                                 formatter_class=argparse.RawDescriptionHelpFormatter)
    sub = ap.add_subparsers(dest="cmd", required=True)

    u = sub.add_parser("update", help="verify -> ABI-gate -> warm swap (or reboot) -> health -> commit")
    u.add_argument("bundle", nargs="?", help="bundle directory")
    u.add_argument("--dry-run", action="store_true", help="print what would change (warm vs reboot); no swap")
    u.add_argument("--rollback", action="store_true", help="symmetric warm swap back to the previous bundle")
    u.add_argument("--rollback-to", help="backing to treat as 'previous' when none is recorded (default A)")
    u.add_argument("--reset", choices=["hotplug"], default=None,
                   help="trigger the guest re-handshake via QMP device_del+add (process stays alive)")
    u.add_argument("--backend-reload-cmd",
                   help="command that reloads the REAL host renderer (backend-process restart + vfio "
                        "reconnect) for a backend_reload=backend-process bundle; run after device-swap")
    add_target_opts(u)
    add_health_opts(u)
    u.add_argument("--ioreg-cmd"); u.add_argument("--ioreg-file")
    u.set_defaults(fn=cmd_update)

    ap_ = sub.add_parser("apply", help="one-shot install/update: HOST warm-swap (or reboot-stage) + GUEST kext")
    ap_.add_argument("bundle", nargs="?", help="bundle directory (host backend + optional guest kext)")
    ap_.add_argument("--dry-run", action="store_true",
                     help="print the plan (warm vs reboot; guest-needed or not); no swap, no guest touch")
    ap_.add_argument("--rollback", action="store_true", help="symmetric warm swap back to the previous backing")
    ap_.add_argument("--rollback-to", help="backing to treat as 'previous' when none is recorded (default A)")
    ap_.add_argument("--reset", choices=["hotplug"], default=None,
                     help="trigger the guest re-handshake via QMP device_del+add (process stays alive)")
    ap_.add_argument("--backend-reload-cmd",
                     help="command that reloads the REAL host renderer (qdev-host backend-process restart "
                          "+ vfio reconnect) for a backend_reload=backend-process bundle; run after device-swap")
    ap_.add_argument("--host-bundle-dir", help="staged host bundle dir to repoint the device unit at (PVE target)")
    ap_.add_argument("--guest-ssh", help="guest exec channel: [user@]host[:port] (auto-push + install the kext)")
    ap_.add_argument("--no-guest-exec", action="store_true",
                     help="never exec in the guest; only PRINT the sudo uniq-vgpu-guest-install one-liner")
    ap_.add_argument("--guest-reboot", action="store_true",
                     help="let the remote guest-install reboot the guest (default: --no-reboot)")
    ap_.add_argument("--guest-kextstat-file",
                     help="off-channel: a captured `kmutil inspect`/kextstat to read the resident kext uuid from")
    add_target_opts(ap_)
    add_health_opts(ap_)
    ap_.add_argument("--ioreg-cmd"); ap_.add_argument("--ioreg-file")
    ap_.set_defaults(fn=cmd_apply)

    r = sub.add_parser("rollback", help="symmetric warm swap back to the previous bundle")
    r.add_argument("--reset", choices=["hotplug"], default=None)
    add_target_opts(r)
    add_health_opts(r)
    r.set_defaults(fn=cmd_rollback)

    s = sub.add_parser("status", help="active bundle + envelope/ABI + ioreg triplet + health")
    add_target_opts(s)
    add_health_opts(s)
    s.add_argument("--ioreg-cmd", help="command that prints the guest ioreg triplet")
    s.add_argument("--ioreg-file", help="file holding the guest ioreg triplet")
    s.set_defaults(fn=cmd_status)

    args = ap.parse_args(argv)
    if args.cmd in ("update", "apply") and not args.rollback and not args.bundle:
        ap.error(f"{args.cmd} needs a bundle (or --rollback)")
    try:
        return args.fn(args) or EX_OK
    except UpdateError as e:
        print(f"uniq-vgpu: {e}", file=sys.stderr)
        return EX_ERR


if __name__ == "__main__":
    sys.exit(main())
